{
	"name": "astro-academy",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"setup": "node --env-file-if-exists=.dev.vars scripts/setup.mjs",
		"seed": "node --env-file-if-exists=.dev.vars seed/seed.mjs",
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"deploy": "astro build && wrangler deploy",
		"check": "astro check",
		"test": "vitest run",
		"test:build": "node --env-file-if-exists=.dev.vars tests/check-build.mjs",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.4.9",
		"@fontsource-variable/schibsted-grotesk": "5.3.0",
		"@lucide/astro": "1.81.0",
		"@monopane/sdk": "0.4.0",
		"@tailwindcss/vite": "4.3.5",
		"astro": "7.4.13",
		"tailwindcss": "4.3.5"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@playwright/test": "1.63.0",
		"typescript": "5.9.3",
		"vitest": "5.1.1",
		"wrangler": "4.167.0"
	},
	"site": {
		"clientJavaScript": true
	}
}
