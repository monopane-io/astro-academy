---
import CourseAction from "../../../components/blocks/CourseAction.astro";
import CourseOutline from "../../../components/blocks/CourseOutline.astro";
import PageIntro from "../../../components/blocks/PageIntro.astro";
import Tag from "../../../components/ui/Tag.astro";
import Base from "../../../layouts/Base.astro";
import { coursePage } from "../../../lib/pages";

const { response, data } = await coursePage(Astro);
if (response) return response;
const { course } = data;
---

<Base title={course.title} description={course.description}>
	<PageIntro
		title={course.title}
		text={course.description}
		back={{ href: "/", label: "All courses" }}
		editHref={data.editHref}
		editLabel="Edit this course"
	>
		{
			(course.duration || course.tags.length > 0) && (
				<Fragment slot="meta">
					{course.duration && (
						<span class="mr-1 font-medium" data-course-duration>
							{course.duration}
						</span>
					)}
					{course.tags.map((tag) => (
						<Tag size="sm" href={tag.href}>
							{tag.name}
						</Tag>
					))}
				</Fragment>
			)
		}
	</PageIntro>
	{
		course.imageUrl && (
			<img class="mt-8 aspect-[16/9] w-full rounded-xl object-cover" src={course.imageUrl} alt="" />
		)
	}

	<CourseAction page={data} />
	<CourseOutline outline={data.outline} enrolled={data.enrolled} />
</Base>
