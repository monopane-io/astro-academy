---
import Certificate from "../../../components/blocks/Certificate.astro";
import Message from "../../../components/blocks/Message.astro";
import PageIntro from "../../../components/blocks/PageIntro.astro";
import Button from "../../../components/ui/Button.astro";
import ProgressRing from "../../../components/ui/ProgressRing.astro";
import TextLink from "../../../components/ui/TextLink.astro";
import Base from "../../../layouts/Base.astro";
import { completePage } from "../../../lib/pages";

const { config } = Astro.locals;
const { response, data } = await completePage(Astro);
if (response) return response;
const { course, certificate } = data;
---

<Base title={`${course.title}: certificate`}>
	{
		certificate ? (
			<>
				<PageIntro
					class="no-print"
					title={`You completed ${course.title}`}
					back={{ href: course.href, label: course.title }}
				/>
				<div class="mt-8">
					<Certificate
						issuer={config.siteName}
						name={data.userName}
						course={course.title}
						issuedOn={certificate.issuedOn}
						code={certificate.code}
					/>
				</div>
				<p class="no-print mt-8">
					Anyone can check this certificate at{" "}
					<TextLink class="break-all" href={certificate.verifyPath}>
						{certificate.verifyUrl}
					</TextLink>
				</p>
				<p class="no-print mt-2 text-muted-foreground text-sm">
					To keep a copy, use your browser's Print command and choose "Save as PDF".
				</p>
			</>
		) : (
			<Message
				title="Not finished yet"
				text={`${data.progress && data.progress.total > 0 ? `${data.progress.done} of ${data.progress.total} activities done. ` : ""}You get a certificate when every activity in ${course.title} is done and every quiz is passed.`}
				data-not-finished
			>
				{data.progress && data.progress.total > 0 && (
					<ProgressRing slot="lead" size="lg" value={data.progress.done} max={data.progress.total} />
				)}
				<Button variant="primary" size="lg" href={course.href}>
					Go back to the course
				</Button>
			</Message>
		)
	}
</Base>
