---
import Base from "../../../layouts/Base.astro";
import { lessonPage } from "../../../lib/pages";

const { response, data } = await lessonPage(Astro);
if (response) return response;
const { course, lesson } = data;
const head = "flex flex-wrap items-center justify-between gap-x-4 gap-y-2";
const heading = "font-semibold text-2xl tracking-tight";
const choice =
	"flex cursor-pointer items-center gap-3 rounded-lg border border-border bg-card px-4 py-3 has-checked:border-primary has-checked:bg-primary-soft";
---

<Base title={lesson.title} description={lesson.description} wide>
	<div class="grid gap-x-12 gap-y-8 lg:grid-cols-[17rem_minmax(0,1fr)]">
		<aside class="lg:sticky lg:top-24 lg:self-start" aria-label="Course contents">
			<p class="mb-4 text-sm">
				<a class="text-muted-foreground hover:text-primary" href={course.href}>{course.title}</a>
			</p>
			{/* Open on a wide screen; on a narrow one it folds away above the lesson. */}
			<details class="group rounded-xl border border-border bg-card lg:border-0 lg:bg-transparent" open>
				<summary class="cursor-pointer px-4 py-3 font-semibold lg:hidden">Course contents</summary>
				<div class="px-4 pb-3 lg:p-0">
					{
						data.outline.map((section) => (
							<>
								{section.moduleTitle && (
									<h2 class="mt-5 mb-1 font-semibold text-muted-foreground text-sm first:mt-0">
										{section.moduleTitle}
									</h2>
								)}
								<ol class="track">
									{section.lessons.map((item) => (
										<li data-lesson-state={item.status}>
											<a
												class="text-muted-foreground hover:text-foreground aria-[current=page]:font-semibold aria-[current=page]:text-foreground"
												href={item.href}
												aria-current={item.current ? "page" : undefined}
											>
												{item.title}
											</a>
										</li>
									))}
								</ol>
							</>
						))
					}
				</div>
			</details>
		</aside>

		<div class="min-w-0 max-w-prose">
			<h1>{lesson.title}</h1>
			{lesson.description && <p class="mt-4 text-muted-foreground text-xl">{lesson.description}</p>}

			{data.activities.length === 0 && <p class="note mt-8">This lesson has nothing in it yet.</p>}

			{
				data.activities.map((activity) => (
					<section
						class="mt-10 flex flex-col gap-4 border-border border-t pt-10"
						id={activity.id}
						data-activity={activity.type}
					>
						{activity.type === "quiz" && (
							<>
								<div class={head}>
									<h2 class={heading}>{activity.title}</h2>
									<span
										class:list={[
											"pill",
											{ "pill-done": activity.done, "pill-failed": activity.status === "failed" },
										]}
										data-state
									>
										{activity.status === "passed"
											? "Passed"
											: activity.status === "failed"
												? "Not passed yet"
												: "Not attempted"}
									</span>
								</div>

								{activity.result && (
									<p
										class:list={["note", activity.result.passed ? "note-success" : "note-error"]}
										role="status"
										data-quiz-result={activity.result.passed ? "passed" : "failed"}
									>
										You scored {activity.result.score}
										{activity.result.passed
											? ". You passed."
											: `. You need ${activity.result.needed} to pass. Change your answers and try again.`}
									</p>
								)}
								{!activity.result && activity.done && activity.bestScore && (
									<p class="text-muted-foreground">Your best score: {activity.bestScore}.</p>
								)}

								{activity.showForm && (
									<form
										class="flex flex-col gap-8"
										method="post"
										action={`${data.action}#${activity.id}`}
									>
										<input type="hidden" name="activityId" value={activity.id} />
										{activity.questions.map((question) => (
											<fieldset class="flex min-w-0 flex-col gap-2" data-question={question.type}>
												<legend class="mb-3 font-medium text-lg">
													{question.text}
													{question.correct !== null && (
														<span
															class:list={[
																"font-normal text-base",
																question.correct ? "text-success" : "text-destructive",
															]}
														>
															{question.correct ? " (correct)" : " (not correct)"}
														</span>
													)}
												</legend>
												{question.type === "multiple_choice" &&
													question.options.map((option) => (
														<label class={choice}>
															<input
																class="size-4 accent-primary"
																type="radio"
																name={question.field}
																value={option}
																checked={question.given.includes(option)}
															/>
															<span>{option}</span>
														</label>
													))}
												{question.type === "multi_select" && (
													<>
														<p class="-mt-2 mb-1 text-muted-foreground text-sm">
															Choose every answer that applies.
														</p>
														{question.options.map((option) => (
															<label class={choice}>
																<input
																	class="size-4 accent-primary"
																	type="checkbox"
																	name={question.field}
																	value={option}
																	checked={question.given.includes(option)}
																/>
																<span>{option}</span>
															</label>
														))}
													</>
												)}
												{question.type === "fill_in_blank" && (
													<input
														class="field"
														type="text"
														name={question.field}
														aria-label={question.text}
														autocomplete="off"
														value={question.given[0] ?? ""}
													/>
												)}
												{question.type === "short_answer" && (
													<textarea
														class="field"
														name={question.field}
														rows="3"
														aria-label={question.text}
														set:text={question.given[0] ?? ""}
													/>
												)}
											</fieldset>
										))}
										{activity.canSubmit && (
											<p>
												<button class="btn" type="submit">
													{activity.submitLabel}
												</button>
											</p>
										)}
									</form>
								)}
							</>
						)}

						{activity.type === "video" && (
							<>
								<div class={head}>
									<h2 class={heading}>{activity.title}</h2>
									<span class:list={["pill", { "pill-done": activity.done }]} data-state>
										{activity.done ? "Watched" : "Not watched"}
									</span>
								</div>
								{activity.duration && (
									<p class="-mt-2 text-muted-foreground text-sm">{activity.duration}</p>
								)}
								{activity.description && <p class="text-lg">{activity.description}</p>}
								{activity.player?.kind === "embed" && (
									<iframe
										class="aspect-video w-full rounded-xl bg-foreground"
										src={activity.player.src}
										title={activity.title}
										loading="lazy"
										referrerpolicy="strict-origin-when-cross-origin"
										allow="fullscreen; picture-in-picture; encrypted-media"
										allowfullscreen
									/>
								)}
								{activity.player?.kind === "file" && (
									<video
										class="aspect-video w-full rounded-xl bg-foreground"
										src={activity.player.src}
										controls
										preload="metadata"
									/>
								)}
								{activity.player?.kind === "link" && (
									<p>
										<a
											class="link"
											href={activity.player.href}
											target="_blank"
											rel="noopener noreferrer"
										>
											Watch the video
										</a>
									</p>
								)}
								{!activity.player && (
									<p class="note note-error">This video's address cannot be played.</p>
								)}
							</>
						)}

						{activity.type === "reading" && (
							<>
								<div class={head}>
									<h2 class={heading}>{activity.title}</h2>
									<span class:list={["pill", { "pill-done": activity.done }]} data-state>
										{activity.done ? "Done" : "Not done"}
									</span>
								</div>
								{activity.minutes !== null && (
									<p class="-mt-2 text-muted-foreground text-sm">
										About {activity.minutes} min to read.
									</p>
								)}
								<div class="reading" set:html={activity.html} />
							</>
						)}

						{activity.type === "external_link" && (
							<>
								<div class={head}>
									<h2 class={heading}>{activity.title}</h2>
									<span class:list={["pill", { "pill-done": activity.done }]} data-state>
										{activity.done ? "Done" : "Not done"}
									</span>
								</div>
								{activity.description && <p class="text-lg">{activity.description}</p>}
								{activity.url && (
									<p>
										<a
											class="link break-all"
											href={activity.url}
											target={activity.newTab ? "_blank" : undefined}
											rel="noopener noreferrer"
										>
											{activity.url}
										</a>
									</p>
								)}
							</>
						)}

						{activity.type !== "quiz" && !activity.done && (
							<form method="post" action={data.action} data-stay>
								<input type="hidden" name="activityId" value={activity.id} />
								<button class="btn btn-quiet" type="submit">
									{activity.type === "video"
										? "Mark as watched"
										: activity.type === "reading"
											? "Mark as read"
											: "Mark as done"}
								</button>
							</form>
						)}
					</section>
				))
			}

			{
				data.courseCompleted && (
					<p class="note note-success mt-10" data-course-complete>
						You have completed {course.title}.{" "}
						<a class="font-semibold underline underline-offset-4" href={data.certificateHref}>
							See your certificate
						</a>
					</p>
				)
			}

			<nav
				class="mt-12 flex flex-wrap justify-between gap-4 border-border border-t pt-6"
				aria-label="Lessons"
			>
				{
					data.previous ? (
						<a class="btn btn-quiet" href={data.previous.href}>
							Previous: {data.previous.title}
						</a>
					) : (
						<span />
					)
				}
				{
					data.following ? (
						<a class="btn" href={data.following.href}>
							Next: {data.following.title}
						</a>
					) : (
						<a class="btn" href={course.href}>
							Back to the course
						</a>
					)
				}
			</nav>
		</div>
	</div>
</Base>
