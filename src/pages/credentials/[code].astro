---
import Facts from "../../components/blocks/Facts.astro";
import PageIntro from "../../components/blocks/PageIntro.astro";
import Alert from "../../components/ui/Alert.astro";
import Badge from "../../components/ui/Badge.astro";
import Base from "../../layouts/Base.astro";
import { credentialPage } from "../../lib/pages";

/** Public: anyone with a credential's code can check it here. */
const { response, data } = await credentialPage(Astro);
if (response) return response;
const { credential } = data;
if (!credential) Astro.response.status = 404;
const facts = credential
	? [
			{ name: "Course", value: credential.courseTitle },
			{ name: "Awarded to", value: credential.userName },
			{ name: "Issued by", value: credential.issuedBy },
			{ name: "Issued on", value: credential.issuedOn },
			{ name: "Code", value: credential.code, code: true },
		]
	: [];
---

<Base title="Check a credential">
	{
		credential ? (
			<>
				<PageIntro title="This credential is valid">
					<Badge slot="meta" variant="success" dot>
						Checked just now
					</Badge>
				</PageIntro>
				<Facts class="mt-8" items={facts} data-credential-valid />
			</>
		) : (
			<>
				<PageIntro title="This credential is not valid" />
				<Alert variant="error" class="mt-6" data-credential-invalid>
					No valid credential has this code. Either the code is wrong, or the credential has been
					revoked.
				</Alert>
				<p class="mt-4 text-muted-foreground">
					Check the code and try again, or ask the person who gave it to you.
				</p>
			</>
		)
	}
</Base>
