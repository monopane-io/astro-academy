---
import Base from "../../layouts/Base.astro";
import { credentialPage } from "../../lib/pages";

/** Public: anyone with a credential's code can check it here. */
const { response, data } = await credentialPage(Astro);
if (response) return response;
const { credential } = data;
if (!credential) Astro.response.status = 404;
const facts = credential
	? [
			["Course", credential.courseTitle],
			["Awarded to", credential.userName],
			["Issued by", credential.issuedBy],
			["Issued on", credential.issuedOn],
		]
	: [];
---

<Base title="Check a credential">
	{
		credential ? (
			<>
				<p class="pill pill-done">Checked just now</p>
				<h1 class="mt-4">This credential is valid</h1>
				<div class="mt-8 rounded-xl border border-border bg-card" data-credential-valid>
					<dl class="divide-y divide-border">
						{facts.map(([name, value]) => (
							<div class="flex flex-wrap justify-between gap-x-6 gap-y-1 px-5 py-3.5">
								<dt class="text-muted-foreground">{name}</dt>
								<dd class="font-medium">{value}</dd>
							</div>
						))}
						<div class="flex flex-wrap justify-between gap-x-6 gap-y-1 px-5 py-3.5">
							<dt class="text-muted-foreground">Code</dt>
							<dd class="font-medium tabular-nums tracking-wider">{credential.code}</dd>
						</div>
					</dl>
				</div>
			</>
		) : (
			<>
				<h1>This credential is not valid</h1>
				<p class="note note-error mt-6" data-credential-invalid>
					No valid credential has this code. Either the code is wrong, or the credential has been
					revoked.
				</p>
				<p class="mt-4 text-muted-foreground">
					Check the code and try again, or ask the person who gave it to you.
				</p>
			</>
		)
	}
</Base>
