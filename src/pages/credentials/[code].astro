---
import Base from "../../layouts/Base.astro";
import { credentialPage } from "../../lib/pages";

/** Public: anyone with a credential's code can check it here. */
const { response, data } = await credentialPage(Astro);
if (response) return response;
const { credential } = data;
if (!credential) Astro.response.status = 404;
---

<Base title="Check a credential">
	{
		credential ? (
			<>
				<h1>This credential is valid</h1>
				<div class="credential" data-credential-valid>
					<dl class="facts">
						<dt>Course</dt>
						<dd>{credential.courseTitle}</dd>
						<dt>Awarded to</dt>
						<dd>{credential.learnerName}</dd>
						<dt>Issued by</dt>
						<dd>{credential.issuedBy}</dd>
						<dt>Issued on</dt>
						<dd>{credential.issuedOn}</dd>
						<dt>Code</dt>
						<dd class="credential-code">{credential.code}</dd>
					</dl>
				</div>
			</>
		) : (
			<>
				<h1>This credential is not valid</h1>
				<p class="message error" data-credential-invalid>
					No valid credential has this code. Either the code is wrong, or the credential has been
					revoked.
				</p>
				<p>Check the code and try again, or ask the person who gave it to you.</p>
			</>
		)
	}
</Base>
