---
import Base from "../layouts/Base.astro";
import { myLearningPage } from "../lib/pages";

/** The user's own page: what they are enrolled in, how far along, and their credentials. */
const { response, data } = await myLearningPage(Astro);
if (response) return response;
const { inProgress, completed } = data;
const row =
	"flex flex-wrap items-center justify-between gap-x-6 gap-y-4 rounded-xl border border-border bg-card p-5";
---

<Base title="My learning">
	<h1>My learning</h1>

	{
		inProgress.length + completed.length === 0 && (
			<>
				<p class="mt-4 text-lg text-muted-foreground">You are not enrolled in anything yet.</p>
				<p class="mt-8">
					<a class="btn" href="/">
						Browse courses
					</a>
				</p>
			</>
		)
	}

	{
		inProgress.length > 0 && (
			<section class="mt-10" data-in-progress>
				<h2 class="font-semibold text-muted-foreground">In progress</h2>
				<ul class="mt-3 flex flex-col gap-3">
					{inProgress.map(({ course, progress, nextHref, started }) => (
						<li class={row}>
							<div class="min-w-56 flex-1">
								<h3 class="font-semibold text-xl tracking-tight">
									<a class="hover:text-primary" href={course.href}>
										{course.title}
									</a>
								</h3>
								<p class="mt-1 text-muted-foreground text-sm">
									{progress.done} of {progress.total} activities done
								</p>
								<progress
									class="meter mt-3"
									value={progress.done}
									max={Math.max(progress.total, 1)}
								/>
							</div>
							{nextHref && (
								<a class="btn" href={nextHref}>
									{started ? "Continue" : "Start"}
								</a>
							)}
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		completed.length > 0 && (
			<section class="mt-10" data-completed>
				<h2 class="font-semibold text-muted-foreground">Completed</h2>
				<ul class="mt-3 flex flex-col gap-3">
					{completed.map(({ course, completedOn, certificateHref }) => (
						<li class={row}>
							<div class="min-w-56 flex-1">
								<h3 class="font-semibold text-xl tracking-tight">
									<a class="hover:text-primary" href={course.href}>
										{course.title}
									</a>
								</h3>
								{completedOn && (
									<p class="mt-1 text-muted-foreground text-sm">Completed on {completedOn}</p>
								)}
							</div>
							<a class="btn btn-quiet" href={certificateHref}>
								See your certificate
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Base>
