---
import LearningList from "../components/blocks/LearningList.astro";
import LearningRow from "../components/blocks/LearningRow.astro";
import Message from "../components/blocks/Message.astro";
import PageIntro from "../components/blocks/PageIntro.astro";
import Button from "../components/ui/Button.astro";
import ProgressRing from "../components/ui/ProgressRing.astro";
import Base from "../layouts/Base.astro";
import { myLearningPage } from "../lib/pages";

/** The user's own page: what they are enrolled in, how far along, and their credentials. */
const { response, data } = await myLearningPage(Astro);
if (response) return response;
const { inProgress, completed } = data;
---

<Base title="My learning">
	{
		inProgress.length + completed.length === 0 ? (
			<Message title="My learning" text="You are not enrolled in anything yet.">
				<Button variant="primary" size="lg" href="/">
					Browse courses
				</Button>
			</Message>
		) : (
			<PageIntro title="My learning" />
		)
	}

	{
		inProgress.length > 0 && (
			<LearningList title="In progress" data-in-progress>
				{inProgress.map(({ course, progress, nextHref, started }) => (
					<LearningRow
						title={course.title}
						href={course.href}
						meta={`${progress.done} of ${progress.total} activities done`}
					>
						<ProgressRing slot="lead" value={progress.done} max={progress.total} />
						{nextHref && (
							<Button slot="action" variant="primary" size="lg" href={nextHref}>
								{started ? "Continue" : "Start"}
							</Button>
						)}
					</LearningRow>
				))}
			</LearningList>
		)
	}

	{
		completed.length > 0 && (
			<LearningList title="Completed" data-completed>
				{completed.map(({ course, completedOn, certificateHref }) => (
					<LearningRow
						title={course.title}
						href={course.href}
						meta={completedOn ? `Completed on ${completedOn}` : null}
					>
						<Button slot="action" variant="secondary" size="lg" href={certificateHref}>
							See your certificate
						</Button>
					</LearningRow>
				))}
			</LearningList>
		)
	}
</Base>
