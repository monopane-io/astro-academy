---
import Empty from "../../../components/blocks/Empty.astro";
import Facts from "../../../components/blocks/Facts.astro";
import Feed from "../../../components/blocks/Feed.astro";
import PageHeader from "../../../components/blocks/PageHeader.astro";
import Section from "../../../components/blocks/Section.astro";
import Split from "../../../components/blocks/Split.astro";
import Table from "../../../components/blocks/Table.astro";
import TableFilters from "../../../components/blocks/TableFilters.astro";
import Badge from "../../../components/ui/Badge.astro";
import Progress from "../../../components/ui/Progress.astro";
import Admin from "../../../layouts/Admin.astro";
import { ENROLLMENT_STATES, userPage } from "../../../lib/admin/users";

const { response, data } = await userPage(Astro);
if (response) return response;
const { user } = data;
const facts = [
	{ name: "Email", value: user.email ?? "Not given" },
	{ name: "Joined on", value: user.joinedOn },
	{ name: "Reference", value: user.reference },
];
---

<Admin title={user.name} minutesLeft={data.minutesLeft}>
	<PageHeader title={user.name} trail={[{ href: "/admin/users", label: "Users" }]} />

	<Split>
		<Facts slot="aside" title="About" stacked items={facts} data-admin-user-facts />

	<Section title="Courses" id="courses">
		{
			data.enrollmentCount === 0 ? (
				<Empty title="Not enrolled in anything yet" />
			) : (
				<Table
					label="Courses"
					columns={[
						{ label: "Course", sortHref: data.sort.course.href, sorted: data.sort.course.sorted },
						{ label: "Status" },
						{ label: "Progress", hide: true },
						{ label: "Enrolled", align: "right", hide: true, sortHref: data.sort.enrolled.href, sorted: data.sort.enrolled.sorted },
					]}
				>
					<TableFilters
						slot="toolbar"
						action="#courses"
						filters={[{ name: "status", label: "Status", value: data.status, anyLabel: "Any status", options: ENROLLMENT_STATES }]}
						keep={data.keep}
						clearHref={data.clearHref}
					/>
					{data.enrollments.map((enrollment) => (
						<tr data-admin-enrollment={enrollment.courseTitle}>
							<td>
								<a class="font-medium hover:text-primary" href={enrollment.courseHref}>{enrollment.courseTitle}</a>
								<span class="block text-muted-foreground text-xs md:hidden">{enrollment.progressLabel}</span>
							</td>
							<td>
								<Badge variant={enrollment.completed ? "success" : "neutral"} data-state>{enrollment.status}</Badge>
							</td>
							<td class="hidden md:table-cell">
								<span class="flex items-center gap-3">
									{enrollment.activitiesTotal !== null && (
										<Progress class="w-20" value={enrollment.activitiesDone} max={enrollment.activitiesTotal} aria-label={`Progress in ${enrollment.courseTitle}`} />
									)}
									<span class="whitespace-nowrap text-muted-foreground tabular-nums">{enrollment.progressLabel}</span>
								</span>
							</td>
							<td class="hidden whitespace-nowrap text-right text-muted-foreground md:table-cell">
								{enrollment.enrolledOn}
								{enrollment.completedOn && <span class="block text-xs">Completed {enrollment.completedOn}</span>}
							</td>
						</tr>
					))}
					{data.enrollments.length === 0 && (
						<Empty slot="empty" bare icon="book" title="No course in this state" description="Choose another status, or clear the filter." />
					)}
				</Table>
			)
		}
	</Section>

	<Section title="Activity" id="activity" description="The latest things this user did.">
		<Feed items={data.activity} data-admin-activity-feed />
	</Section>
	</Split>
</Admin>
