---
import Empty from "../../../components/blocks/Empty.astro";
import Facts from "../../../components/blocks/Facts.astro";
import Feed from "../../../components/blocks/Feed.astro";
import ItemList from "../../../components/blocks/ItemList.astro";
import ItemRow from "../../../components/blocks/ItemRow.astro";
import PageHeader from "../../../components/blocks/PageHeader.astro";
import Section from "../../../components/blocks/Section.astro";
import Split from "../../../components/blocks/Split.astro";
import Badge from "../../../components/ui/Badge.astro";
import Admin from "../../../layouts/Admin.astro";
import { userPage } from "../../../lib/admin/users";

const { response, data } = await userPage(Astro);
if (response) return response;
const { user } = data;
const facts = [
	{ name: "Email", value: user.email ?? "Not given" },
	{ name: "Joined on", value: user.joinedOn },
	{ name: "Reference", value: user.reference },
];
---

<Admin title={user.name} minutesLeft={data.minutesLeft}>
	<PageHeader title={user.name} trail={[{ href: "/admin/users", label: "Users" }]} />

	<Split>
		<Facts slot="aside" title="About" stacked items={facts} data-admin-user-facts />

	<Section title="Courses" id="courses">
		{
			data.enrollments.length === 0 ? (
				<Empty title="Not enrolled in anything yet" />
			) : (
				<ItemList>
					{data.enrollments.map((enrollment) => (
						<ItemRow
							title={enrollment.courseTitle}
							href={enrollment.courseHref}
							meta={`${enrollment.activitiesDone} ${enrollment.activitiesDone === 1 ? "activity" : "activities"} done. Enrolled on ${enrollment.enrolledOn}${enrollment.completedOn ? `, completed on ${enrollment.completedOn}` : ""}.`}
							data-admin-enrollment={enrollment.courseTitle}
						>
							<Badge slot="status" variant={enrollment.completed ? "success" : "neutral"} data-state>
								{enrollment.status}
							</Badge>
						</ItemRow>
					))}
				</ItemList>
			)
		}
	</Section>

	<Section title="Activity" id="activity" description="The latest things this user did.">
		<Feed items={data.activity} data-admin-activity-feed />
	</Section>
	</Split>
</Admin>
