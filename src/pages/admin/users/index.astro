---
import Empty from "../../../components/blocks/Empty.astro";
import PageHeader from "../../../components/blocks/PageHeader.astro";
import Pager from "../../../components/blocks/Pager.astro";
import Table from "../../../components/blocks/Table.astro";
import Avatar from "../../../components/ui/Avatar.astro";
import Admin from "../../../layouts/Admin.astro";
import { usersPage } from "../../../lib/admin/users";

const { response, data } = await usersPage(Astro);
if (response) return response;
---

<Admin title="Users" minutesLeft={data.minutesLeft}>
	<PageHeader
		title="Users"
		description="Everyone who has signed in to the academy, newest first. You can see how each is doing; nothing here changes a user."
	/>

	{
		data.users.length === 0 ? (
			<Empty
				icon="users"
				title={data.later ? "No more users" : "Nobody has signed in yet"}
				description={data.later ? undefined : "People appear here the first time they sign in to the academy."}
			/>
		) : (
			<Table
				label="Users"
				columns={[{ label: "User" }, { label: "Email", hide: true }, { label: "Joined", align: "right" }]}
			>
				{data.users.map((user) => (
					<tr data-admin-user={user.email ?? user.name}>
						<td>
							<a class="flex items-center gap-3 font-medium hover:text-primary" href={user.href}>
								<Avatar name={user.name} size="sm" />
								{user.name}
							</a>
						</td>
						<td class="hidden text-muted-foreground md:table-cell">{user.email ?? "Not given"}</td>
						<td class="whitespace-nowrap text-right text-muted-foreground text-sm">{user.joinedOn}</td>
					</tr>
				))}
				<Pager
					slot="footer"
					summary={data.later ? "Older users" : `The newest ${data.users.length}`}
					firstHref={data.later ? "/admin/users" : null}
					firstLabel="Newest"
					nextHref={data.moreHref}
					nextLabel="Older"
				/>
			</Table>
		)
	}
</Admin>
