---
import Empty from "../../../components/blocks/Empty.astro";
import PageHeader from "../../../components/blocks/PageHeader.astro";
import Pager from "../../../components/blocks/Pager.astro";
import Table from "../../../components/blocks/Table.astro";
import TableFilters from "../../../components/blocks/TableFilters.astro";
import Avatar from "../../../components/ui/Avatar.astro";
import Admin from "../../../layouts/Admin.astro";
import { ENROLLMENT_STATES, usersPage } from "../../../lib/admin/users";

const { response, data } = await usersPage(Astro);
if (response) return response;
---

<Admin title="Users" minutesLeft={data.minutesLeft}>
	<PageHeader
		title="Users"
		description="Everyone who has signed in to the academy. You can see how each is doing; nothing here changes a user."
	/>

	<Table
		label="Users"
		columns={[
			{ label: "User", sortHref: data.sort.name.href, sorted: data.sort.name.sorted },
			{ label: "Email", hide: true },
			{ label: "Joined", align: "right", sortHref: data.sort.joined.href, sorted: data.sort.joined.sorted },
		]}
	>
		<TableFilters
			slot="toolbar"
			search={{ name: "q", value: data.search, label: "Search users", placeholder: "Name, email or reference" }}
			filters={[
				{ name: "course", label: "Course", value: data.course, anyLabel: "Any course", options: data.courses },
				{ name: "status", label: "Enrolment", value: data.status, anyLabel: "Any enrolment", options: ENROLLMENT_STATES },
			]}
			keep={data.keep}
			clearHref={data.clearHref}
		/>
		{
			data.users.map((user) => (
				<tr data-admin-user={user.email ?? user.name}>
					<td>
						<a class="flex items-center gap-3 font-medium hover:text-primary" href={user.href}>
							<Avatar name={user.name} size="sm" />
							{user.name}
						</a>
					</td>
					<td class="hidden text-muted-foreground md:table-cell">{user.email ?? "Not given"}</td>
					<td class="whitespace-nowrap text-right text-muted-foreground text-sm">{user.joinedOn}</td>
				</tr>
			))
		}
		{
			data.users.length === 0 && (
				<Empty
					slot="empty"
					icon="users"
					bare
					title={
						data.search
							? `Nobody matches "${data.search}"`
							: data.narrowed
								? "Nobody matches these filters"
								: "Nobody has signed in yet"
					}
					description={
						data.narrowed
							? "Try part of a name, an email address or a reference, or clear the filters."
							: "People appear here the first time they sign in to the academy."
					}
				/>
			)
		}
		<Pager
			slot="footer"
			summary={data.summary}
			firstHref={data.firstHref}
			firstLabel="Back to the start"
			nextHref={data.moreHref}
			nextLabel="More"
		/>
	</Table>
</Admin>
