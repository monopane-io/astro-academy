---
import Checklist from "../../components/blocks/Checklist.astro";
import Empty from "../../components/blocks/Empty.astro";
import ItemList from "../../components/blocks/ItemList.astro";
import ItemRow from "../../components/blocks/ItemRow.astro";
import PageHeader from "../../components/blocks/PageHeader.astro";
import Section from "../../components/blocks/Section.astro";
import Stats from "../../components/blocks/Stats.astro";
import Table from "../../components/blocks/Table.astro";
import Avatar from "../../components/ui/Avatar.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import Card from "../../components/ui/Card.astro";
import Admin from "../../layouts/Admin.astro";
import { overviewPage } from "../../lib/admin/pages";

const { response, data } = await overviewPage(Astro);
if (response) return response;
---

<Admin title="Overview" minutesLeft={data.minutesLeft}>
	<PageHeader title="Overview" description="How the academy is doing.">
		<Button slot="actions" variant="primary" href="/admin/courses/new">New course</Button>
	</PageHeader>

	<Stats items={data.stats} data-admin-stats />

	{
		!data.setUp && (
			<Section title="Set up your academy" id="set-up">
				<Card class="max-w-form">
					<Checklist steps={data.steps} data-admin-checklist />
				</Card>
			</Section>
		)
	}

	<Section title="Courses" id="courses">
		<Button slot="actions" href="/admin/courses" size="sm">All courses</Button>
		{
			data.courses.length === 0 ? (
				<Empty icon="book" title="No courses yet" description="A course is a set of lessons." />
			) : (
				<Table
					label="Courses"
					columns={[
						{ label: "Course" },
						{ label: "Status" },
						{ label: "Enrolled", align: "right" },
						{ label: "Completed", align: "right", hide: true },
					]}
				>
					{data.courses.map((course) => (
						<tr>
							<td class="font-medium">
								<a class="hover:text-primary" href={course.href}>
									{course.title}
								</a>
							</td>
							<td>
								<Badge variant={course.published ? "success" : "neutral"}>
									{course.published ? "Published" : "Draft"}
								</Badge>
							</td>
							<td class="text-right tabular-nums">{course.enrolled}</td>
							<td class="hidden text-right tabular-nums md:table-cell">{course.completed}</td>
						</tr>
					))}
				</Table>
			)
		}
	</Section>

	<Section title="Newest users" id="users">
		<Button slot="actions" href="/admin/users" size="sm">All users</Button>
		{
			data.recentUsers.length === 0 ? (
				<Empty
					icon="users"
					title="Nobody has signed in yet"
					description="People appear here the first time they sign in to the academy."
				/>
			) : (
				<ItemList>
					{data.recentUsers.map((user) => (
						<ItemRow title={user.name} href={user.href} meta={user.email}>
							<Avatar slot="media" name={user.name} />
							<span slot="status" class="hidden text-muted-foreground text-sm sm:inline">
								Joined on {user.joinedOn}
							</span>
						</ItemRow>
					))}
				</ItemList>
			)
		}
	</Section>
</Admin>
