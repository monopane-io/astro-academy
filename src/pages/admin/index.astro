---
import AdminNotice from "../../components/AdminNotice.astro";
import Admin from "../../layouts/Admin.astro";
import { adminHomePage } from "../../lib/admin/pages";

const { response, data } = await adminHomePage(Astro);
if (response) return response;
---

<Admin title="Courses" minutesLeft={data.minutesLeft}>
	<AdminNotice done={data.done} error={data.error} />
	<h1>Courses</h1>
	<p class="mt-3 text-muted-foreground" data-admin-summary>
		{data.published} published, {data.drafts} in draft.
	</p>

	{
		data.courses.length === 0 ? (
			<p class="note mt-8">There are no courses yet. Make the first one below.</p>
		) : (
			<ul class="mt-8 divide-y divide-border rounded-xl border border-border bg-card">
				{data.courses.map((course) => (
					<li
						class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-4"
						data-admin-course={course.slug}
					>
						<div class="min-w-0">
							<p class="font-semibold text-lg tracking-tight">
								<a class="hover:text-primary" href={course.editHref}>
									{course.title}
								</a>
							</p>
							<p class="text-muted-foreground text-sm">Changed on {course.updatedOn}</p>
						</div>
						<div class="flex items-center gap-4">
							<span class:list={["pill", { "pill-done": course.published }]} data-state>
								{course.published ? "Published" : "Draft"}
							</span>
							{course.viewHref && (
								<a class="link text-sm" href={course.viewHref}>
									View
								</a>
							)}
							<a class="link text-sm" href={course.editHref} aria-label={`Edit ${course.title}`}>
								Edit
							</a>
						</div>
					</li>
				))}
			</ul>
		)
	}

	<section class="mt-12 max-w-prose" aria-labelledby="new-course">
		<h2 class="font-semibold text-2xl tracking-tight" id="new-course">New course</h2>
		<p class="mt-1 text-muted-foreground">
			It starts as a draft: users do not see it until you publish it.
		</p>
		<form class="mt-5 flex flex-col gap-4" method="post">
			<div class="flex flex-col gap-1.5">
				<label class="font-medium text-sm" for="new-title">Course title</label>
				<input class="field" id="new-title" name="title" type="text" required maxlength="500" />
			</div>
			<div class="flex flex-col gap-1.5">
				<label class="font-medium text-sm" for="new-description">What it covers (optional)</label>
				<textarea class="field" id="new-description" name="description" rows="2" maxlength="5000"
				></textarea>
			</div>
			<p>
				<button class="btn" type="submit">Create course</button>
			</p>
		</form>
	</section>
</Admin>
