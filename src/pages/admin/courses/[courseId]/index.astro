---
import CourseHeader from "../../../../components/blocks/CourseHeader.astro";
import ItemList from "../../../../components/blocks/ItemList.astro";
import ItemRow from "../../../../components/blocks/ItemRow.astro";
import Notice from "../../../../components/blocks/Notice.astro";
import Section from "../../../../components/blocks/Section.astro";
import Badge from "../../../../components/ui/Badge.astro";
import Button from "../../../../components/ui/Button.astro";
import Menu from "../../../../components/ui/Menu.astro";
import MenuItem from "../../../../components/ui/MenuItem.astro";
import Admin from "../../../../layouts/Admin.astro";
import { courseOutlinePage } from "../../../../lib/admin/content";

const { response, data } = await courseOutlinePage(Astro);
if (response) return response;
const { course } = data;
const status = (published: boolean) => (published ? "published" : "draft");
const addInput =
	"h-10 min-w-0 flex-1 rounded-md border border-border bg-card px-3 placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-ring";
---

<Admin title={course.title} minutesLeft={data.minutesLeft}>
	<Notice done={data.done} error={data.error} />
	<CourseHeader
		course={course}
		tab="lessons"
		facts={`${data.enrolled} enrolled, ${data.completed} completed`}
	>
		<Fragment slot="actions">
			{
				data.hasDrafts ? (
					<form method="post">
						<input type="hidden" name="do" value="publish-all" />
						<Button variant="primary" type="submit">
							Publish everything
						</Button>
					</form>
				) : (
					<form method="post">
						<input type="hidden" name="do" value="toggle-course" />
						<input type="hidden" name="status" value="published" />
						<Button type="submit">Move back to draft</Button>
					</form>
				)
			}
			{
				data.hasDrafts && (
					<Menu label={`More for ${course.title}`}>
						<MenuItem fields={{ do: "toggle-course", status: status(course.published) }}>
							{course.published ? "Move the course back to draft" : "Publish the course only"}
						</MenuItem>
					</Menu>
				)
			}
		</Fragment>
	</CourseHeader>

	{
		data.sections.map((section) => (
			<Section
				title={section.module?.title ?? (data.sections.length > 1 ? "Not in a module" : undefined)}
				description={section.module?.description || undefined}
				id={section.module?.id ?? "lessons"}
			>
				{section.module && (
					<div class="flex items-center gap-2" slot="actions" data-admin-module={section.module.title}>
						<Badge variant={section.module.published ? "success" : "neutral"}>
							{section.module.published ? "Published" : "Draft"}
						</Badge>
						<Menu label={`Actions for the module ${section.module.title}`}>
							<MenuItem href={section.module.editHref}>Rename</MenuItem>
							<MenuItem
								fields={{ do: "toggle-module", id: section.module.id, status: status(section.module.published) }}
							>
								{section.module.published ? "Unpublish" : "Publish"}
							</MenuItem>
							<MenuItem
								fields={{ do: "move-module", id: section.module.id, direction: "up" }}
								disabled={section.module.first}
							>
								Move up
							</MenuItem>
							<MenuItem
								fields={{ do: "move-module", id: section.module.id, direction: "down" }}
								disabled={section.module.last}
							>
								Move down
							</MenuItem>
							<MenuItem
								fields={{ do: "delete-module", id: section.module.id }}
								disabled={section.lessons.length > 0}
								destructive
							>
								{section.lessons.length > 0 ? "Delete (move its lessons first)" : "Delete"}
							</MenuItem>
						</Menu>
					</div>
				)}

				<ItemList ordered>
					{section.lessons.map((lesson) => (
						<ItemRow title={lesson.title} href={lesson.href} id={lesson.id} data-admin-lesson={lesson.title}>
							<Badge slot="status" variant={lesson.published ? "success" : "neutral"} data-state>
								{lesson.published ? "Published" : "Draft"}
							</Badge>
							<Menu slot="actions" label={`Actions for ${lesson.title}`}>
								<MenuItem href={lesson.href}>Edit</MenuItem>
								<MenuItem fields={{ do: "toggle-lesson", id: lesson.id, status: status(lesson.published) }}>
									{lesson.published ? "Unpublish" : "Publish"}
								</MenuItem>
								<MenuItem fields={{ do: "move-lesson", id: lesson.id, direction: "up" }} disabled={lesson.first}>
									Move up
								</MenuItem>
								<MenuItem fields={{ do: "move-lesson", id: lesson.id, direction: "down" }} disabled={lesson.last}>
									Move down
								</MenuItem>
							</Menu>
						</ItemRow>
					))}
					<li class="px-4 py-3 sm:px-5">
						<form class="flex flex-wrap gap-2" method="post">
							<input type="hidden" name="do" value="add-lesson" />
							<input type="hidden" name="moduleId" value={section.module?.id ?? ""} />
							<input
								class={addInput}
								name="title"
								type="text"
								required
								maxlength="500"
								placeholder="Title of a new lesson"
								aria-label={section.module ? `New lesson in ${section.module.title}` : "New lesson"}
							/>
							<Button type="submit">Add lesson</Button>
						</form>
					</li>
				</ItemList>
			</Section>
		))
	}

	<Section
		title="Modules"
		description="Modules group lessons, like chapters. A course does not need any."
		id="modules"
	>
		<form class="flex max-w-form flex-wrap gap-2" method="post">
			<input type="hidden" name="do" value="add-module" />
			<input
				class={addInput}
				name="title"
				type="text"
				required
				maxlength="500"
				placeholder="Title of a new module"
				aria-label="New module"
			/>
			<Button type="submit">Add module</Button>
		</form>
	</Section>
</Admin>
