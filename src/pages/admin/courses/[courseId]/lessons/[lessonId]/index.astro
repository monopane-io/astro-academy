---
import DeleteAction from "../../../../../../components/blocks/DeleteAction.astro";
import Empty from "../../../../../../components/blocks/Empty.astro";
import Facts from "../../../../../../components/blocks/Facts.astro";
import ItemList from "../../../../../../components/blocks/ItemList.astro";
import ItemRow from "../../../../../../components/blocks/ItemRow.astro";
import LessonHeader from "../../../../../../components/blocks/LessonHeader.astro";
import Notice from "../../../../../../components/blocks/Notice.astro";
import Section from "../../../../../../components/blocks/Section.astro";
import Split from "../../../../../../components/blocks/Split.astro";
import Badge from "../../../../../../components/ui/Badge.astro";
import Button from "../../../../../../components/ui/Button.astro";
import Menu from "../../../../../../components/ui/Menu.astro";
import MenuItem from "../../../../../../components/ui/MenuItem.astro";
import Admin from "../../../../../../layouts/Admin.astro";
import { lessonPage } from "../../../../../../lib/admin/content";

const { response, data } = await lessonPage(Astro);
if (response) return response;
const { course, lesson } = data;
---

<Admin title={lesson.title} minutesLeft={data.minutesLeft}>
	<Notice done={data.done} error={data.error} />
	<LessonHeader course={course} lesson={lesson} tab="activities" />

	<Split>
		<Facts
			slot="aside"
			title="About this lesson"
			stacked
			items={[
				{ name: "Status", value: lesson.published ? "Published" : "Draft" },
				{ name: "Course", value: course.published ? `${course.title} (published)` : `${course.title} (draft)` },
				{ name: "Activities", value: String(data.activities.length) },
			]}
		/>
	<Section description="What a user does in this lesson, in this order.">
		<Menu slot="actions" label="Add activity" text="Add activity">
			{data.add.map((kind) => <MenuItem href={kind.href}>{kind.label}</MenuItem>)}
		</Menu>
		{
			data.activities.length === 0 ? (
				<Empty
					title="Add this lesson's first activity"
					description="A reading, a video, a link or a quiz. Users go through them in order."
				>
					{data.add.map((kind) => (
						<Button href={kind.href} size="sm">
							Add {kind.label.toLowerCase()}
						</Button>
					))}
				</Empty>
			) : (
				<ItemList ordered>
					{data.activities.map((activity) => (
						<ItemRow
							title={activity.title}
							href={activity.href}
							meta={activity.summary}
							id={activity.id}
							data-admin-activity={activity.typeLabel}
						>
							<Fragment slot="lead">{activity.typeLabel}</Fragment>
							<Badge slot="status" variant={activity.published ? "success" : "neutral"} data-state>
								{activity.published ? "Published" : "Draft"}
							</Badge>
							<Menu slot="actions" label={`Actions for ${activity.title}`}>
								<MenuItem href={activity.href}>Edit</MenuItem>
								<MenuItem
									fields={{
										do: "toggle-activity",
										id: activity.id,
										status: activity.published ? "published" : "draft",
									}}
								>
									{activity.published ? "Unpublish" : "Publish"}
								</MenuItem>
								<MenuItem
									fields={{ do: "move-activity", id: activity.id, direction: "up" }}
									disabled={activity.first}
								>
									Move up
								</MenuItem>
								<MenuItem
									fields={{ do: "move-activity", id: activity.id, direction: "down" }}
									disabled={activity.last}
								>
									Move down
								</MenuItem>
								<DeleteAction part="item" do="delete-activity" of={activity.id} />
							</Menu>
							<DeleteAction
								slot="actions"
								part="dialog"
								do="delete-activity"
								of={activity.id}
								fields={{ id: activity.id }}
								name={activity.title}
								consequence="Progress users have made on it goes with it."
							/>
						</ItemRow>
					))}
				</ItemList>
			)
		}
	</Section>
	</Split>
</Admin>
