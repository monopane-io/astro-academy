---
import AdminNotice from "../../../../../components/AdminNotice.astro";
import Admin from "../../../../../layouts/Admin.astro";
import { lessonEditorPage } from "../../../../../lib/admin/content";

const { response, data } = await lessonEditorPage(Astro);
if (response) return response;
const { course, lesson } = data;

/** What the answers box means for each kind of question. */
const answersLabel = {
	multiple_choice: "The right answer",
	multi_select: "The right answers, one per line",
	fill_in_blank: "Answers that count as right, one per line",
	short_answer: "Words the answer must contain, one per line",
};
const kinds = [
	{ value: "multiple_choice", label: "One right answer" },
	{ value: "multi_select", label: "Several right answers" },
	{ value: "fill_in_blank", label: "Fill in the blank" },
	{ value: "short_answer", label: "Short answer" },
];
---

<Admin title={lesson.title} minutesLeft={data.minutesLeft}>
	<p class="mb-6 text-sm">
		<a class="text-muted-foreground hover:text-primary" href={course.href}>{course.title}</a>
	</p>
	<AdminNotice done={data.done} error={data.error} />

	<div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
		<div class="min-w-0">
			<h1>{lesson.title}</h1>
			<p class="mt-3 flex flex-wrap items-center gap-3 text-muted-foreground">
				<span class:list={["pill", { "pill-done": lesson.published }]} data-lesson-published>
					{lesson.published ? "Published" : "Draft"}
				</span>
				{
					data.viewHref && (
						<a class="link text-sm" href={data.viewHref}>
							View as a user
						</a>
					)
				}
			</p>
		</div>
		<form method="post" data-stay>
			<input type="hidden" name="do" value="toggle-lesson" />
			<input type="hidden" name="status" value={lesson.published ? "published" : "draft"} />
			<button class="btn btn-quiet" type="submit">
				{lesson.published ? "Move back to draft" : "Publish the lesson"}
			</button>
		</form>
	</div>

	<div class="mt-10 grid gap-x-12 gap-y-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
		<section aria-labelledby="activities">
			<h2 class="font-semibold text-2xl tracking-tight" id="activities">Activities</h2>
			<p class="hint mt-1">What a user does in this lesson, in order.</p>

			{data.activities.length === 0 && <p class="note mt-6">Nothing here yet. Add the first below.</p>}

			<ol class="mt-6 flex flex-col gap-5">
				{
					data.activities.map((activity) => (
						<li class="panel" id={activity.id} data-admin-activity={activity.type}>
							<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
								<p class="font-semibold text-muted-foreground text-sm">{activity.typeLabel}</p>
								<div class="flex flex-wrap items-center gap-2">
									<span class:list={["pill", { "pill-done": activity.published }]} data-state>
										{activity.published ? "Published" : "Draft"}
									</span>
									{[
										{ direction: "up", label: "Up", disabled: activity.first },
										{ direction: "down", label: "Down", disabled: activity.last },
									].map(({ direction, label, disabled }) => (
										<form method="post" data-stay>
											<input type="hidden" name="do" value="move-activity" />
											<input type="hidden" name="id" value={activity.id} />
											<input type="hidden" name="direction" value={direction} />
											<button
												class="btn-small"
												type="submit"
												disabled={disabled}
												aria-label={`Move ${direction}: ${activity.title}`}
											>
												{label}
											</button>
										</form>
									))}
									<form method="post" data-stay>
										<input type="hidden" name="do" value="toggle-activity" />
										<input type="hidden" name="id" value={activity.id} />
										<input
											type="hidden"
											name="status"
											value={activity.published ? "published" : "draft"}
										/>
										<button
											class="btn-small"
											type="submit"
											aria-label={`${activity.published ? "Unpublish" : "Publish"}: ${activity.title}`}
										>
											{activity.published ? "Unpublish" : "Publish"}
										</button>
									</form>
									<form method="post" data-stay>
										<input type="hidden" name="do" value="delete-activity" />
										<input type="hidden" name="id" value={activity.id} />
										<button
											class="btn-small"
											type="submit"
											aria-label={`Delete: ${activity.title}`}
										>
											Delete
										</button>
									</form>
								</div>
							</div>

							<form class="flex flex-col gap-4" method="post" data-stay>
								<input type="hidden" name="do" value="save-activity" />
								<input type="hidden" name="id" value={activity.id} />
								<div class="flex flex-col gap-1.5">
									<label class="label" for={`title-${activity.id}`}>
										Title
									</label>
									<input
										class="field"
										id={`title-${activity.id}`}
										name="title"
										type="text"
										required
										maxlength="500"
										value={activity.title}
									/>
								</div>

								{activity.type === "reading" && (
									<>
										<div class="flex flex-col gap-1.5">
											<label class="label" for={`content-${activity.id}`}>
												Text
											</label>
											<textarea
												class="field font-mono text-sm"
												id={`content-${activity.id}`}
												name="content"
												rows="12"
												maxlength="100000"
												aria-describedby={`content-hint-${activity.id}`}
												set:text={activity.content}
											/>
											<p class="hint" id={`content-hint-${activity.id}`}>
												Leave a blank line between paragraphs. # for a heading, - for a list,
												**bold**, *italic*, [a link](https://example.com).
											</p>
										</div>
										<div class="flex flex-col gap-1.5">
											<label class="label" for={`minutes-${activity.id}`}>
												Minutes to read (optional)
											</label>
											<input
												class="field max-w-40"
												id={`minutes-${activity.id}`}
												name="minutes"
												type="number"
												min="1"
												max="480"
												value={activity.minutes}
											/>
										</div>
									</>
								)}

								{(activity.type === "video" || activity.type === "external_link") && (
									<>
										<div class="flex flex-col gap-1.5">
											<label class="label" for={`url-${activity.id}`}>
												{activity.type === "video" ? "Address of the video" : "Address of the link"}
											</label>
											<input
												class="field"
												id={`url-${activity.id}`}
												name="url"
												type="url"
												required
												maxlength="2000"
												value={activity.url}
											/>
										</div>
										<div class="flex flex-col gap-1.5">
											<label class="label" for={`description-${activity.id}`}>
												A line about it (optional)
											</label>
											<input
												class="field"
												id={`description-${activity.id}`}
												name="description"
												type="text"
												maxlength="500"
												value={activity.description}
											/>
										</div>
										{activity.type === "video" ? (
											<div class="flex flex-col gap-1.5">
												<label class="label" for={`duration-${activity.id}`}>
													Length in minutes (optional)
												</label>
												<input
													class="field max-w-40"
													id={`duration-${activity.id}`}
													name="durationMinutes"
													type="number"
													min="1"
													max="1440"
													value={activity.durationMinutes}
												/>
											</div>
										) : (
											<label class="flex items-center gap-2">
												<input
													class="size-4 accent-primary"
													type="checkbox"
													name="newTab"
													checked={activity.newTab}
												/>
												<span>Open in a new tab</span>
											</label>
										)}
									</>
								)}

								{activity.type === "quiz" && (
									<div class="flex flex-col gap-1.5">
										<label class="label" for={`pass-${activity.id}`}>
											Score needed to pass, in percent
										</label>
										<input
											class="field max-w-40"
											id={`pass-${activity.id}`}
											name="passPercent"
											type="number"
											min="0"
											max="100"
											required
											value={activity.passPercent}
										/>
									</div>
								)}

								<p>
									<button class="btn btn-quiet" type="submit">
										Save {activity.typeLabel.toLowerCase()}
									</button>
								</p>
							</form>

							{activity.type === "quiz" && (
								<div class="mt-6 border-border border-t pt-5">
									<h3 class="font-semibold">Questions</h3>
									<ol class="mt-4 flex flex-col gap-6">
										{activity.questions.map((question, index) => (
											<li data-admin-question={question.kind}>
												<form class="flex flex-col gap-3" method="post" data-stay>
													<input type="hidden" name="do" value="save-question" />
													<input type="hidden" name="id" value={activity.id} />
													<input type="hidden" name="questionId" value={question.id} />
													<p class="hint">
														Question {index + 1}: {question.kindLabel.toLowerCase()}
													</p>
													<div class="flex flex-col gap-1.5">
														<label class="label" for={`q-text-${question.id}`}>
															Question
														</label>
														<input
															class="field"
															id={`q-text-${question.id}`}
															name="text"
															type="text"
															required
															maxlength="2000"
															value={question.text}
														/>
													</div>
													{(question.kind === "multiple_choice" ||
														question.kind === "multi_select") && (
														<div class="flex flex-col gap-1.5">
															<label class="label" for={`q-options-${question.id}`}>
																Choices, one per line
															</label>
															<textarea
																class="field"
																id={`q-options-${question.id}`}
																name="options"
																rows="4"
																required
																set:text={question.options}
															/>
														</div>
													)}
													<div class="flex flex-col gap-1.5">
														<label class="label" for={`q-answers-${question.id}`}>
															{answersLabel[question.kind]}
														</label>
														<textarea
															class="field"
															id={`q-answers-${question.id}`}
															name="answers"
															rows={question.kind === "multiple_choice" ? 1 : 3}
															required
															set:text={question.answers}
														/>
													</div>
													<p>
														<button class="btn-small" type="submit">
															Save question {index + 1}
														</button>
													</p>
												</form>
												<form class="mt-2" method="post" data-stay>
													<input type="hidden" name="do" value="delete-question" />
													<input type="hidden" name="id" value={activity.id} />
													<input type="hidden" name="questionId" value={question.id} />
													<button
														class="btn-small"
														type="submit"
														disabled={activity.questions.length <= 1}
													>
														Delete question {index + 1}
													</button>
												</form>
											</li>
										))}
									</ol>

									<details class="mt-6 rounded-lg border border-border px-4 py-3">
										<summary class="cursor-pointer font-medium">Add a question</summary>
										<form class="mt-4 flex flex-col gap-3" method="post" data-stay>
											<input type="hidden" name="do" value="add-question" />
											<input type="hidden" name="id" value={activity.id} />
											<div class="flex flex-col gap-1.5">
												<label class="label" for={`nq-kind-${activity.id}`}>
													Kind of question
												</label>
												<select class="field" id={`nq-kind-${activity.id}`} name="kind">
													{kinds.map((kind) => (
														<option value={kind.value}>{kind.label}</option>
													))}
												</select>
											</div>
											<div class="flex flex-col gap-1.5">
												<label class="label" for={`nq-text-${activity.id}`}>
													New question
												</label>
												<input
													class="field"
													id={`nq-text-${activity.id}`}
													name="text"
													type="text"
													required
													maxlength="2000"
												/>
											</div>
											<div class="flex flex-col gap-1.5">
												<label class="label" for={`nq-options-${activity.id}`}>
													Choices, one per line (leave empty for fill in the blank and short answer)
												</label>
												<textarea
													class="field"
													id={`nq-options-${activity.id}`}
													name="options"
													rows="4"
												/>
											</div>
											<div class="flex flex-col gap-1.5">
												<label class="label" for={`nq-answers-${activity.id}`}>
													Right answers, one per line
												</label>
												<textarea
													class="field"
													id={`nq-answers-${activity.id}`}
													name="answers"
													rows="3"
													required
													aria-describedby={`nq-hint-${activity.id}`}
												/>
												<p class="hint" id={`nq-hint-${activity.id}`}>
													For a question with choices, write the right one exactly as it appears
													above. For a short answer, write words the answer must contain.
												</p>
											</div>
											<p>
												<button class="btn btn-quiet" type="submit">
													Add question
												</button>
											</p>
										</form>
									</details>
								</div>
							)}
						</li>
					))
				}
			</ol>

			<h3 class="mt-10 font-semibold text-xl tracking-tight">Add an activity</h3>
			<div class="mt-4 flex flex-col gap-3">
				<details class="panel" data-add="reading">
					<summary class="cursor-pointer font-medium">A reading</summary>
					<form class="mt-4 flex flex-col gap-3" method="post">
						<input type="hidden" name="do" value="add-activity" />
						<input type="hidden" name="type" value="reading" />
						<div class="flex flex-col gap-1.5">
							<label class="label" for="add-reading-title">Reading title</label>
							<input class="field" id="add-reading-title" name="title" type="text" required maxlength="500" />
						</div>
						<div class="flex flex-col gap-1.5">
							<label class="label" for="add-reading-content">Reading text</label>
							<textarea class="field font-mono text-sm" id="add-reading-content" name="content" rows="8" maxlength="100000"
							></textarea>
						</div>
						<p><button class="btn btn-quiet" type="submit">Add reading</button></p>
					</form>
				</details>

				<details class="panel" data-add="video">
					<summary class="cursor-pointer font-medium">A video</summary>
					<form class="mt-4 flex flex-col gap-3" method="post">
						<input type="hidden" name="do" value="add-activity" />
						<input type="hidden" name="type" value="video" />
						<div class="flex flex-col gap-1.5">
							<label class="label" for="add-video-title">Video title</label>
							<input class="field" id="add-video-title" name="title" type="text" required maxlength="500" />
						</div>
						<div class="flex flex-col gap-1.5">
							<label class="label" for="add-video-url">Video address</label>
							<input class="field" id="add-video-url" name="url" type="url" required pattern="https://.*" placeholder="https://" maxlength="2000" aria-describedby="add-video-hint" />
							<p class="hint" id="add-video-hint">
								A YouTube, Vimeo, Loom or Wistia page, or an https link to a video file.
							</p>
						</div>
						<p><button class="btn btn-quiet" type="submit">Add video</button></p>
					</form>
				</details>

				<details class="panel" data-add="external_link">
					<summary class="cursor-pointer font-medium">A link</summary>
					<form class="mt-4 flex flex-col gap-3" method="post">
						<input type="hidden" name="do" value="add-activity" />
						<input type="hidden" name="type" value="external_link" />
						<input type="hidden" name="newTab" value="on" />
						<div class="flex flex-col gap-1.5">
							<label class="label" for="add-link-title">Link title</label>
							<input class="field" id="add-link-title" name="title" type="text" required maxlength="500" />
						</div>
						<div class="flex flex-col gap-1.5">
							<label class="label" for="add-link-url">Link address</label>
							<input class="field" id="add-link-url" name="url" type="url" required placeholder="https://" maxlength="2000" />
						</div>
						<p><button class="btn btn-quiet" type="submit">Add link</button></p>
					</form>
				</details>

				<details class="panel" data-add="quiz">
					<summary class="cursor-pointer font-medium">A quiz</summary>
					<form class="mt-4 flex flex-col gap-3" method="post">
						<input type="hidden" name="do" value="add-activity" />
						<input type="hidden" name="type" value="quiz" />
						<div class="flex flex-col gap-1.5">
							<label class="label" for="add-quiz-title">Quiz title</label>
							<input class="field" id="add-quiz-title" name="title" type="text" required maxlength="500" />
						</div>
						<div class="flex flex-col gap-1.5">
							<label class="label" for="add-quiz-pass">Score needed to pass, in percent</label>
							<input class="field max-w-40" id="add-quiz-pass" name="passPercent" type="number" min="0" max="100" value="70" required />
						</div>
						<p class="hint">A quiz starts with one question. Add the rest once it is made.</p>
						<div class="flex flex-col gap-1.5">
							<label class="label" for="add-quiz-kind">Kind of first question</label>
							<select class="field" id="add-quiz-kind" name="kind">
								{kinds.map((kind) => <option value={kind.value}>{kind.label}</option>)}
							</select>
						</div>
						<div class="flex flex-col gap-1.5">
							<label class="label" for="add-quiz-text">First question</label>
							<input class="field" id="add-quiz-text" name="text" type="text" required maxlength="2000" />
						</div>
						<div class="flex flex-col gap-1.5">
							<label class="label" for="add-quiz-options">First question's choices, one per line</label>
							<textarea class="field" id="add-quiz-options" name="options" rows="4"></textarea>
						</div>
						<div class="flex flex-col gap-1.5">
							<label class="label" for="add-quiz-answers">First question's right answers, one per line</label>
							<textarea class="field" id="add-quiz-answers" name="answers" rows="2" required></textarea>
						</div>
						<p><button class="btn btn-quiet" type="submit">Add quiz</button></p>
					</form>
				</details>
			</div>
		</section>

		<section aria-labelledby="details">
			<h2 class="font-semibold text-2xl tracking-tight" id="details">About the lesson</h2>
			<form class="mt-6 flex flex-col gap-4" method="post">
				<input type="hidden" name="do" value="save-lesson" />
				<div class="flex flex-col gap-1.5">
					<label class="label" for="lesson-title">Lesson title</label>
					<input class="field" id="lesson-title" name="title" type="text" required maxlength="500" value={lesson.title} />
				</div>
				<div class="flex flex-col gap-1.5">
					<label class="label" for="lesson-description">What it covers (optional)</label>
					<textarea class="field" id="lesson-description" name="description" rows="3" maxlength="5000"
						set:text={lesson.description}
					/>
				</div>
				{
					data.modules.length > 0 && (
						<div class="flex flex-col gap-1.5">
							<label class="label" for="lesson-module">
								Module
							</label>
							<select class="field" id="lesson-module" name="moduleId">
								<option value="" selected={lesson.moduleId === ""}>
									None: directly under the course
								</option>
								{data.modules.map((module) => (
									<option value={module.id} selected={module.id === lesson.moduleId}>
										{module.title}
									</option>
								))}
							</select>
						</div>
					)
				}
				<p><button class="btn" type="submit">Save lesson</button></p>
			</form>

			<form class="panel mt-10 flex flex-col gap-3" method="post">
				<input type="hidden" name="do" value="delete-lesson" />
				<h3 class="font-semibold">Delete this lesson</h3>
				<p class="hint">This cannot be undone. Its activities go with it.</p>
				<label class="flex items-center gap-2">
					<input class="size-4 accent-primary" type="checkbox" name="confirm" value="yes" required />
					<span>Yes, delete {lesson.title}</span>
				</label>
				<p><button class="btn btn-danger" type="submit">Delete lesson</button></p>
			</form>
		</section>
	</div>
</Admin>
