---
import Empty from "../../../components/blocks/Empty.astro";
import Notice from "../../../components/blocks/Notice.astro";
import PageHeader from "../../../components/blocks/PageHeader.astro";
import Table from "../../../components/blocks/Table.astro";
import Badge from "../../../components/ui/Badge.astro";
import Button from "../../../components/ui/Button.astro";
import Input from "../../../components/ui/Input.astro";
import Admin from "../../../layouts/Admin.astro";
import { coursesPage } from "../../../lib/admin/pages";

const { response, data } = await coursesPage(Astro);
if (response) return response;
---

<Admin title="Courses" minutesLeft={data.minutesLeft}>
	<Notice done={data.done} />
	<PageHeader title="Courses">
		<span slot="status" data-admin-summary>{data.published} published, {data.drafts} in draft</span>
		<Button slot="actions" variant="primary" href="/admin/courses/new">Create course</Button>
	</PageHeader>

	{
		data.total === 0 ? (
			<Empty
				icon="book"
				title="Create your first course"
				description="A course is a set of lessons. It starts as a draft, and users see it once you publish it."
			>
				<Button variant="primary" href="/admin/courses/new">
					Create course
				</Button>
			</Empty>
		) : (
			<Table
				label="Courses"
				columns={[
					{ label: "Course", sortHref: data.sort.title.href, sorted: data.sort.title.sorted },
					{ label: "Status" },
					{
						label: "Changed",
						align: "right",
						hide: true,
						sortHref: data.sort.changed.href,
						sorted: data.sort.changed.sorted,
					},
				]}
			>
				<form slot="toolbar" class="flex w-full flex-wrap items-center gap-2" method="get" role="search">
					<Input
						class="max-w-xs flex-1"
						type="search"
						name="q"
						icon="search"
						value={data.search}
						placeholder="Title or address"
						aria-label="Search courses"
					/>
					<Button type="submit">Search</Button>
					{data.search && (
						<Button href={data.clearHref} variant="ghost">
							Clear
						</Button>
					)}
				</form>
				{data.courses.length === 0 && (
					<Empty
						slot="empty"
						icon="book"
						bare
						title={`No course matches "${data.search}"`}
						description="Try part of a title or an address."
					/>
				)}
				{data.courses.map((course) => (
					<tr data-admin-course={course.slug}>
						<td class="font-medium">
							<a class="hover:text-primary" href={course.editHref}>
								{course.title}
							</a>
						</td>
						<td>
							<Badge variant={course.published ? "success" : "neutral"} data-state>
								{course.published ? "Published" : "Draft"}
							</Badge>
						</td>
						<td class="hidden whitespace-nowrap text-right text-muted-foreground md:table-cell">
							{course.updatedOn}
						</td>
					</tr>
				))}
			</Table>
		)
	}
</Admin>
