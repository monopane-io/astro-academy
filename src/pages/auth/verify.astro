---
import Base from "../../layouts/Base.astro";
import { verifyLinkPage } from "../../lib/pages";

/** Where an emailed sign-in link lands. See verifyLinkPage for why it shows a button. */
const { response, data } = await verifyLinkPage(Astro);
if (response) return response;
---

<Base title="Sign in">
	<div class="mx-auto max-w-sm">
		<h1 class="text-3xl sm:text-4xl">Sign in</h1>
		{
			data.failed ? (
				<>
					<p class="note note-error mt-6" role="alert" data-link-failed>
						This sign-in link has been used or has expired.
					</p>
					<p class="mt-6">
						<a class="link" href="/sign-in">
							Ask for a new link
						</a>
					</p>
				</>
			) : (
				<form method="post">
					<input type="hidden" name="token" value={data.token} />
					<p class="mt-3 text-muted-foreground">Press the button to finish signing in.</p>
					<button class="btn mt-6 w-full" type="submit">
						Finish signing in
					</button>
				</form>
			)
		}
	</div>
</Base>
