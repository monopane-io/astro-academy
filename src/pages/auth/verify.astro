---
import Alert from "../../components/ui/Alert.astro";
import Button from "../../components/ui/Button.astro";
import TextLink from "../../components/ui/TextLink.astro";
import Auth from "../../layouts/Auth.astro";
import { verifyLinkPage } from "../../lib/pages";

/** Where an emailed sign-in link lands. See verifyLinkPage for why it shows a button. */
const { response, data } = await verifyLinkPage(Astro);
if (response) return response;
---

<Auth title="Sign in">
		{
			data.failed ? (
				<>
					<Alert variant="error" class="mt-6" role="alert" data-link-failed>
						This sign-in link has been used or has expired.
					</Alert>
					<p class="mt-6">
						<TextLink href="/sign-in">
							Ask for a new link
						</TextLink>
					</p>
				</>
			) : (
				<form method="post">
					<input type="hidden" name="token" value={data.token} />
					<p class="mt-2 text-center text-muted-foreground text-sm">Press the button to finish signing in.</p>
					<Button variant="primary" class="mt-6 w-full" type="submit">
						Finish signing in
					</Button>
				</form>
			)
		}
</Auth>
