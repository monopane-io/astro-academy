---
import Banner from "../components/blocks/Banner.astro";
import Breadcrumbs from "../components/blocks/Breadcrumbs.astro";
import Certificate from "../components/blocks/Certificate.astro";
import Checklist from "../components/blocks/Checklist.astro";
import Empty from "../components/blocks/Empty.astro";
import Feed from "../components/blocks/Feed.astro";
import Pager from "../components/blocks/Pager.astro";
import Section from "../components/blocks/Section.astro";
import Stats from "../components/blocks/Stats.astro";
import Table from "../components/blocks/Table.astro";
import Alert from "../components/ui/Alert.astro";
import Avatar from "../components/ui/Avatar.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import Checkbox from "../components/ui/Checkbox.astro";
import Dialog from "../components/ui/Dialog.astro";
import Field from "../components/ui/Field.astro";
import Icon from "../components/ui/Icon.astro";
import Input from "../components/ui/Input.astro";
import Menu from "../components/ui/Menu.astro";
import MenuItem from "../components/ui/MenuItem.astro";
import Progress from "../components/ui/Progress.astro";
import ProgressRing from "../components/ui/ProgressRing.astro";
import RadioGroup from "../components/ui/RadioGroup.astro";
import Skeleton from "../components/ui/Skeleton.astro";
import Tag from "../components/ui/Tag.astro";
import TextLink from "../components/ui/TextLink.astro";
import Toggle from "../components/ui/Toggle.astro";
import Tooltip from "../components/ui/Tooltip.astro";
import Document from "../layouts/Document.astro";

// Every component in every variant, on one page, to look the system over.
// It exists only while developing (npm run dev); a built site answers 404.
if (!import.meta.env.DEV) return new Response(null, { status: 404 });

const variants = ["primary", "secondary", "ghost", "destructive"] as const;
const sizes = ["sm", "md", "lg"] as const;
const row = "flex flex-wrap items-center gap-3";
---

<Document title="Design" class="mx-auto max-w-4xl px-4 py-10 sm:px-8">
	<h1>Design</h1>
	<p class="mt-3 text-lg text-muted-foreground">Every component, in every variant.</p>

	<Section title="Buttons">
		<div class="flex flex-col gap-3">
			{
				sizes.map((size) => (
					<div class={row}>
						{variants.map((variant) => (
							<Button variant={variant} size={size}>
								{variant} {size}
							</Button>
						))}
						<Button size={size} icon aria-label="Add">
							<Icon name="plus" />
						</Button>
					</div>
				))
			}
			<div class={row}>
				<Button variant="primary" disabled>Disabled</Button>
				<Button variant="primary" aria-busy="true">Saving</Button>
				<Button aria-busy="true">Saving</Button>
				<Button href="#">A link</Button>
				<Button variant="primary"><Icon name="plus" />With an icon</Button>
			</div>
		</div>
	</Section>

	<Section title="Badges, tags and avatars">
		<div class="flex flex-col gap-3">
			<div class={row}>
				<Badge>Draft</Badge>
				<Badge variant="success">Published</Badge>
				<Badge variant="destructive">Failed</Badge>
				<Badge variant="primary">New</Badge>
				<Badge variant="success" dot>Active</Badge>
				<Badge dot>Idle</Badge>
			</div>
			<div class={row}>
				<Tag href="#">Topic</Tag>
				<Tag href="#" current>Current topic</Tag>
				<Tag href="#" size="sm">Small</Tag>
			</div>
			<div class={row}>
				<Avatar name="Grace Hopper" size="sm" />
				<Avatar name="Grace Hopper" />
				<Avatar name="Ada" size="lg" />
			</div>
		</div>
	</Section>

	<Section title="Form controls">
		<Card class="flex max-w-form flex-col gap-5">
			<Field label="Title" name="title" value="A tour of this academy" hint="Shown at the top of the course." />
			<Field label="Address" name="slug" value="not valid!" error="Small letters, numbers and hyphens only." />
			<Field label="Notes" name="notes" as="textarea" optional />
			<Field label="Kind of question" name="kind" as="select">
				<option>One right answer</option>
				<option>Several right answers</option>
			</Field>
			<Field label="Minutes" name="minutes" type="number" value={10} narrow />
			<Input aria-label="Address with a prefix" prefix="/courses/" value="academy-tour" />
			<Input aria-label="Search" type="search" icon="search" placeholder="Search users" />
			<Checkbox label="A box to tick" name="box" checked />
			<Toggle label="Published" name="published" checked hint="Users can see it." />
			<Toggle label="Off" name="off" />
			<RadioGroup
				label="Who can enrol"
				name="who"
				value="anyone"
				options={[
					{ value: "anyone", label: "Anyone", hint: "Every signed-in user." },
					{ value: "invited", label: "Invited people only" },
				]}
			/>
		</Card>
	</Section>

	<Section title="Feedback">
		<div class="flex max-w-form flex-col gap-3">
			<Alert>Something worth knowing.</Alert>
			<Alert variant="success">That worked.</Alert>
			<Alert variant="error">That did not work, and here is why.</Alert>
			<Progress value={3} max={8} />
			<div class={row}>
				<ProgressRing value={1} max={6} />
				<ProgressRing value={5} max={6} size="lg" />
			</div>
			<Banner>A banner: something everyone should know.</Banner>
			<Banner variant="info">A quieter banner.</Banner>
			<div class={row}>
				<Tooltip text="More about this">
					<Button icon aria-label="More"><Icon name="info" /></Button>
				</Tooltip>
				<TextLink href="#">A link in text</TextLink>
			</div>
			<div class="flex items-center gap-3">
				<Skeleton class="size-9 rounded-full" />
				<div class="flex flex-1 flex-col gap-2">
					<Skeleton class="h-4 w-1/3" />
					<Skeleton class="h-3 w-2/3" />
				</div>
			</div>
		</div>
	</Section>

	<Section title="Menu and dialog">
		<div class={row}>
			<Menu label="Actions" text="Actions">
				<MenuItem href="#">Edit</MenuItem>
				<MenuItem href="#" destructive>Delete</MenuItem>
			</Menu>
			<Menu label="Actions for a row">
				<MenuItem href="#">Edit</MenuItem>
			</Menu>
			<Button data-dialog-open="example">Open a dialog</Button>
		</div>
		<Dialog id="example" title="Delete this course?">
			Its lessons and activities go with it. This cannot be undone.
			<Fragment slot="actions">
				<form method="dialog"><Button type="submit">Cancel</Button></form>
				<form method="dialog"><Button variant="destructive" type="submit">Yes, delete it</Button></form>
			</Fragment>
		</Dialog>
	</Section>

	<Section title="Empty state">
		<Empty title="Nothing here yet" description="Things appear here once there are some.">
			<Button variant="primary">Add one</Button>
		</Empty>
	</Section>

	<Section title="Breadcrumbs">
		<Breadcrumbs
			trail={[
				{ href: "#", label: "Courses" },
				{ href: "#", label: "A tour of this academy" },
				{ href: "#", label: "Quizzes" },
			]}
		/>
	</Section>

	<Section title="Stats">
		<Stats
			items={[
				{ label: "Published courses", value: 3, hint: "1 in draft" },
				{ label: "Enrolments", value: 128, hint: "40 in progress" },
				{ label: "Completions", value: 88 },
				{ label: "Completion rate", value: "69%" },
			]}
		/>
	</Section>

	<Section title="Table">
		<Table
			label="Example"
			columns={[{ label: "Course" }, { label: "Status" }, { label: "Enrolled", align: "right" }]}
		>
			<Input slot="toolbar" aria-label="Search" type="search" icon="search" placeholder="Search" class="max-w-xs" />
			<tr>
				<td class="font-medium">A tour of this academy</td>
				<td><Badge variant="success">Published</Badge></td>
				<td class="text-right tabular-nums">128</td>
			</tr>
			<tr>
				<td class="font-medium">Onboarding</td>
				<td><Badge>Draft</Badge></td>
				<td class="text-right tabular-nums">0</td>
			</tr>
			<Pager slot="footer" summary="The newest 2" firstHref="#" firstLabel="Newest" nextHref="#" nextLabel="Older" />
		</Table>
	</Section>

	<Section title="Card with a header, checklist and feed">
		<div class="grid gap-4 md:grid-cols-2">
			<Card title="Set up your academy" description="Four steps.">
				<Button slot="actions" size="sm">Skip</Button>
				<Checklist
					steps={[
						{ label: "Make a course", done: true },
						{ label: "Publish a course", done: false, hint: "Users see it once it is published.", href: "#" },
					]}
				/>
			</Card>
			<Card title="Activity">
				<Feed
					items={[
						{ text: "Completed A tour of this academy", when: "26 November 2026 at 15:58 UTC", icon: "award" },
						{ text: "Enrolled in A tour of this academy", when: "26 November 2026 at 15:40 UTC", icon: "book" },
					]}
				/>
			</Card>
		</div>
	</Section>

	<Section title="Certificate">
		<Certificate
			issuer="Academy"
			name="Grace Hopper"
			course="A tour of this academy"
			issuedOn="26 November 2026"
			code="ABCD-1234"
		/>
	</Section>

	<Section title="Icons">
		<div class={row}>
			{
				(
					[
						"arrow-down",
						"arrow-left",
						"arrow-right",
						"arrow-up",
						"award",
						"book",
						"check",
						"chevron-down",
						"chevron-left",
						"chevron-right",
						"circle",
						"circle-check",
						"dashboard",
						"ellipsis",
						"external",
						"eye",
						"graduation",
						"inbox",
						"info",
						"log-out",
						"menu",
						"pencil",
						"plus",
						"search",
						"trash",
						"user-plus",
						"users",
						"x",
					] as const
				).map((name) => (
					<Tooltip text={name}>
						<span class="flex size-9 items-center justify-center rounded-md border border-border bg-card">
							<Icon name={name} size="lg" />
						</span>
					</Tooltip>
				))
			}
		</div>
	</Section>
</Document>
