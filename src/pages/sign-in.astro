---
import Alert from "../components/ui/Alert.astro";
import Button from "../components/ui/Button.astro";
import Field from "../components/ui/Field.astro";
import Auth from "../layouts/Auth.astro";
import { signInPage } from "../lib/pages";

const { response, data } = await signInPage(Astro);
if (response) return response;
---

<Auth title="Sign in">
	{
		data.linkSent ? (
			<Alert variant="success" class="mt-6" data-link-sent>
				If that address can receive email, a sign-in link is on its way. It works once and expires in
				15 minutes.
			</Alert>
		) : (
			<>
				<p class="mt-2 text-muted-foreground">
					{data.mode === "demo"
						? "Enter a name and an email address to try the academy. Nothing is sent to you."
						: "Enter your email address and we will send you a link that signs you in."}
				</p>
				{data.error && (
					<Alert variant="error" class="mt-6" role="alert">
						{data.error}
					</Alert>
				)}
				<form class="mt-6 flex flex-col gap-4" method="post">
					<Field label="Your name" name="name" autocomplete="name" value={data.name} />
					<Field
						label="Email address"
						name="email"
						type="email"
						autocomplete="email"
						required
						value={data.email}
					/>
					<Button variant="primary" size="lg" class="mt-2" type="submit">
						{data.mode === "demo" ? "Sign in" : "Email me a sign-in link"}
					</Button>
				</form>
			</>
		)
	}
</Auth>
