---
import Continue from "../components/blocks/Continue.astro";
import CourseGrid from "../components/blocks/CourseGrid.astro";
import CoursePath from "../components/blocks/CoursePath.astro";
import FeaturedCourse from "../components/blocks/FeaturedCourse.astro";
import Hero from "../components/blocks/Hero.astro";
import Alert from "../components/ui/Alert.astro";
import Tag from "../components/ui/Tag.astro";
import Base from "../layouts/Base.astro";
import { homePage } from "../lib/pages";

const { config } = Astro.locals;
const { response, data } = await homePage(Astro);
if (response) return response;
---

<Base title={config.siteName} description={config.tagline} wide>
	<Hero slot="band" title={config.siteName} text={config.tagline}>
		{data.path.length > 1 && <CoursePath steps={data.path} caption={data.pathCaption} />}
	</Hero>

	{data.continuing.length > 0 && <Continue courses={data.continuing} />}
	{data.featured && <FeaturedCourse course={data.featured} />}

	<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
		<h2 class="text-heading">
			{data.tag ? `Courses: ${data.tag}` : "Courses"}
		</h2>
		{
			data.filters.length > 0 && (
				<nav class="flex flex-wrap gap-1.5" aria-label="Filter courses by topic">
					{data.filters.map((filter) => (
						<Tag href={filter.href} current={filter.current}>
							{filter.name}
						</Tag>
					))}
				</nav>
			)
		}
	</div>
	{
		data.courses.length === 0 && !data.featured ? (
			<Alert variant="info" class="mt-6">
				No courses are published yet. Publish a course in Monopane and it appears here within a
				minute.
			</Alert>
		) : (
			<CourseGrid courses={data.courses} />
		)
	}
</Base>
