---
import { cx, focusRing } from "../../lib/ui";

/** A topic to follow: a small rounded link. `current` marks the one in use. */
interface Props {
	href: string;
	current?: boolean;
	size?: "sm" | "md";
}

const { href, current = false, size = "md" } = Astro.props;
---

<a
	class={cx(
		"inline-flex w-fit shrink-0 items-center justify-center whitespace-nowrap rounded-full border font-medium transition-colors",
		size === "sm" ? "px-2 py-0.5 text-xs" : "px-2.5 py-0.5 text-sm",
		current
			? "border-brand bg-brand text-brand-foreground"
			: "border-border text-foreground hover:bg-muted",
		focusRing,
	)}
	href={href}
	aria-current={current ? "true" : undefined}
>
	<slot />
</a>
