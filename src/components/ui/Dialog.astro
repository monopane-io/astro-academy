---
import Icon from "./Icon.astro";

/**
 * A question put in front of the page, which waits for an answer. Open it
 * with any button that has `data-dialog-open` set to this dialog's id. Put
 * what it asks in the default slot and its buttons in the `actions` slot; a
 * <form method="dialog"> button closes it, as does Escape.
 */
interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
---

<dialog
	id={id}
	class="m-auto w-full max-w-[calc(100%-2rem)] rounded-lg border border-border bg-background p-6 text-foreground shadow-lg backdrop:bg-black/50 sm:max-w-lg"
	aria-labelledby={`${id}-title`}
	closedby="any"
>
	<div class="grid gap-4">
		<div class="flex flex-col gap-2 pr-6">
			<h2 class="font-semibold text-lg leading-none" id={`${id}-title`}>{title}</h2>
			<p class="text-muted-foreground text-sm"><slot /></p>
		</div>
		<div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
			<slot name="actions" />
		</div>
	</div>
	<form method="dialog" class="absolute top-4 right-4">
		<button
			class="cursor-pointer rounded-xs opacity-70 outline-none transition-opacity hover:opacity-100 focus-visible:ring-[3px] focus-visible:ring-ring/50"
			type="submit"
			aria-label="Close"
		>
			<Icon name="x" />
		</button>
	</form>
</dialog>
