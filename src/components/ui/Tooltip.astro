---
/**
 * A few words that appear over something when the pointer or the keyboard is
 * on it. For an explanation only: a control still needs a label of its own.
 */
interface Props {
	text: string;
}

const { text } = Astro.props;
---

<span class="group/tip relative inline-flex">
	<slot />
	<span
		class="-translate-x-1/2 pointer-events-none absolute bottom-full left-1/2 z-40 mb-1.5 whitespace-nowrap rounded-md bg-foreground px-2 py-1 font-medium text-background text-xs opacity-0 transition-opacity delay-150 group-focus-within/tip:opacity-100 group-hover/tip:opacity-100"
		role="tooltip"
	>
		{text}
	</span>
</span>
