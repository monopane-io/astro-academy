---
import { variants } from "../../lib/ui";

/** A person, shown as the first letters of their name. */
interface Props {
	name: string;
	size?: "sm" | "md" | "lg";
	class?: string;
}

const avatar = variants(
	"inline-flex shrink-0 select-none items-center justify-center rounded-full bg-primary-soft font-semibold text-primary uppercase",
	{ size: { sm: "size-7 text-xs", md: "size-9 text-sm", lg: "size-12 text-base" } },
	{ size: "md" },
);

const { name, size, class: extra } = Astro.props;
const words = name.trim().split(/\s+/).filter(Boolean);
const initials =
	words.length > 1
		? `${[...(words[0] ?? "")][0] ?? ""}${[...(words[words.length - 1] ?? "")][0] ?? ""}`
		: [...(words[0] ?? "?")].slice(0, 2).join("");
---

<span class={avatar({ size }, extra)} aria-hidden="true">{initials}</span>
