---
import type { HTMLAttributes } from "astro/types";
import { variants } from "../../lib/ui";

/** A message set apart from the page: something worked, failed, or needs saying. */
type Props = {
	variant?: "info" | "success" | "error";
	class?: string;
} & Omit<HTMLAttributes<"p">, "class">;

const alert = variants(
	"rounded-lg border px-4 py-3",
	{
		variant: {
			info: "border-border bg-card text-muted-foreground",
			success: "border-transparent bg-success-soft text-success",
			error: "border-transparent bg-destructive-soft text-destructive",
		},
	},
	{ variant: "info" },
);

const { variant, class: extra, ...rest } = Astro.props;
---

<p class={alert({ variant }, extra)} {...rest}><slot /></p>
