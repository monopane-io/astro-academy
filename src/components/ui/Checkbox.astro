---
import { checkbox } from "../../lib/ui";

/** A box to tick, with its label beside it. */
interface Props {
	label: string;
	name: string;
	value?: string;
	checked?: boolean;
	required?: boolean;
	disabled?: boolean;
	id?: string;
}

const {
	label,
	name,
	value = "on",
	checked = false,
	required = false,
	disabled = false,
	id,
} = Astro.props;
---

<label class="flex cursor-pointer items-center gap-3 font-medium text-sm leading-snug has-disabled:cursor-not-allowed has-disabled:opacity-50">
	<input
		class={checkbox}
		type="checkbox"
		name={name}
		value={value}
		checked={checked}
		required={required}
		disabled={disabled}
		id={id}
	/>
	<span>{label}</span>
</label>
