---
/** One choice out of a few, all visible. For a longer list, use a select. */
interface Props {
	label: string;
	name: string;
	options: { value: string; label: string; hint?: string }[];
	value?: string;
	required?: boolean;
}

const { label, name, options, value, required = false } = Astro.props;
---

<fieldset class="flex flex-col gap-3">
	<legend class="mb-2 font-medium text-sm">{label}</legend>
	{
		options.map((option) => (
			<label class="flex cursor-pointer items-start gap-3 text-sm">
				<input
					class="mt-1 size-4 accent-primary"
					type="radio"
					name={name}
					value={option.value}
					checked={option.value === value}
					required={required}
				/>
				<span class="flex flex-col">
					<span>{option.label}</span>
					{option.hint && <span class="text-muted-foreground text-sm">{option.hint}</span>}
				</span>
			</label>
		))
	}
</fieldset>
