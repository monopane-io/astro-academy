---
import Icon from "./Icon.astro";

/**
 * A short confirmation that shows in the corner for a few seconds and goes
 * away by itself: "Course saved". For anything a person must read or act on,
 * use an <Alert> on the page instead.
 */
interface Props {
	[attribute: string]: unknown;
}

const rest = Astro.props;
---

<p
	class="fixed right-4 bottom-4 z-50 flex max-w-sm animate-toast items-center gap-2.5 rounded-lg border border-border bg-card px-4 py-3 font-medium shadow-black/10 shadow-lg"
	role="status"
	{...rest}
>
	<Icon name="circle-check" size="lg" class="text-success" />
	<span><slot /></span>
</p>
