---
/** A switch: something that is on or off. Sent with a form like a checkbox. */
interface Props {
	label: string;
	name: string;
	value?: string;
	checked?: boolean;
	hint?: string;
}

const { label, name, value = "on", checked = false, hint } = Astro.props;
---

<label class="flex cursor-pointer items-start gap-3">
	<input class="peer sr-only" type="checkbox" role="switch" name={name} value={value} checked={checked} />
	<span
		class="mt-0.5 inline-flex h-[1.15rem] w-8 shrink-0 items-center rounded-full bg-border p-px shadow-xs transition-colors after:size-4 after:rounded-full after:bg-card after:shadow-sm after:transition-transform after:content-[''] peer-checked:bg-brand peer-checked:after:translate-x-[calc(100%-2px)] peer-focus-visible:ring-[3px] peer-focus-visible:ring-ring/50"
		aria-hidden="true"
	>
	</span>
	<span class="flex flex-col">
		<span class="font-medium text-sm">{label}</span>
		{hint && <span class="text-muted-foreground text-sm">{hint}</span>}
	</span>
</label>
