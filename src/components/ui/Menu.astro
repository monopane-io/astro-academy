---
import Icon, { type IconName } from "./Icon.astro";

/**
 * A small menu behind a button, for the less frequent actions on a row or a
 * page: move, unpublish, delete. It is a <details>, so it opens without any
 * script; the admin layout adds closing it on Escape or a click elsewhere.
 * Put <MenuItem>s, or forms holding one, in the slot. The `trigger` slot
 * replaces what is on the button (an avatar and a name, for an account menu).
 */
interface Props {
	/** What the menu is for, read out with the button: "Actions for Welcome". */
	label: string;
	/** Text on the button. Left out, the button shows an icon. */
	text?: string;
	/** The icon when there is no text; three dots unless said. */
	icon?: IconName;
	/** Which edge of the button the menu lines up with. `start` for a button near the left of the page. */
	align?: "start" | "end";
}

const { label, text, icon = "ellipsis", align = "end" } = Astro.props;
const custom = Astro.slots.has("trigger");
---

<details class="group/menu relative" data-menu>
	<summary
		class:list={[
			"inline-flex cursor-pointer list-none items-center justify-center gap-1.5 rounded-md font-medium outline-none hover:bg-muted focus-visible:ring-[3px] focus-visible:ring-ring/50 group-open/menu:bg-muted [&::-webkit-details-marker]:hidden",
			// With words on it, it is a button like any other; without, a quiet icon in a row.
			custom
				? "gap-2 p-1 text-sm"
				: text
					? "h-9 border border-border bg-card px-4 text-sm shadow-xs"
					: "size-8 text-sm",
		]}
		aria-label={text ? undefined : label}
	>
		{
			custom ? (
				<slot name="trigger" />
			) : text ? (
				<>
					{text}
					<Icon name="chevron-down" />
				</>
			) : (
				<Icon name={icon} />
			)
		}
	</summary>
	<div
		class:list={[
			"absolute z-30 mt-1 flex w-max min-w-56 max-w-[calc(100vw-5rem)] flex-col rounded-md border border-border bg-card p-1 shadow-md",
			align === "start" ? "left-0" : "right-0",
		]}
		role="group"
		aria-label={text ? label : undefined}
	>
		<slot />
	</div>
</details>
