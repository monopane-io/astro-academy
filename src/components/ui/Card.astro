---
import { cx, surface } from "../../lib/ui";

/**
 * A surface that holds one thing: a form, a list, a set of facts. With a
 * `title` it has a header, with room for `actions` on its right, and a
 * `footer` slot sits under a line at the bottom.
 */
interface Props {
	title?: string;
	description?: string;
	/** Without padding, for a list or a table whose rows reach the edges. */
	flush?: boolean;
	class?: string;
	[attribute: string]: unknown;
}

const { title, description, flush = false, class: extra, ...rest } = Astro.props;
const hasFooter = Astro.slots.has("footer");
---

<div
	class={cx(
		`flex flex-col text-foreground ${surface}`,
		!flush && "gap-6 py-6",
		extra,
	)}
	{...rest}
>
	{
		title && (
			<div
				class={cx(
					"grid auto-rows-min grid-cols-[1fr_auto] items-start gap-x-4 gap-y-2 px-6",
					flush && "border-border border-b py-4",
				)}
			>
				<h3 class="font-semibold leading-none">{title}</h3>
				<div class="col-start-2 row-span-2 row-start-1 self-start justify-self-end">
					<slot name="actions" />
				</div>
				{description && <p class="text-muted-foreground text-sm">{description}</p>}
			</div>
		)
	}
	{flush ? <slot /> : <div class="px-6"><slot /></div>}
	{
		hasFooter && (
			<div class={cx("flex items-center gap-2 border-border border-t px-6", flush ? "py-4" : "pt-6")}>
				<slot name="footer" />
			</div>
		)
	}
</div>
