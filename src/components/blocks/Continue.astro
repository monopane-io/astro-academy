---
import Button from "../ui/Button.astro";
import LearningRow from "./LearningRow.astro";

/** For a signed-in user on the home page: the courses they are part-way through. */
interface Props {
	courses: { title: string; href: string }[];
}

const { courses } = Astro.props;
---

<section class="mb-12" aria-labelledby="continue" data-continue>
	<h2 class="text-heading" id="continue">Continue where you left off</h2>
	<ul class="mt-4 grid gap-3 sm:grid-cols-2">
		{
			courses.map((course) => (
				<LearningRow title={course.title} href={course.href}>
					<Button slot="action" variant="primary" href={course.href}>
						Continue
					</Button>
				</LearningRow>
			))
		}
	</ul>
</section>
