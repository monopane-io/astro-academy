---
/**
 * The top of the home page: the academy's name, a line about it, and
 * optionally a picture beside them and buttons below (the default slot).
 */
interface Props {
	title: string;
	text?: string | null;
	/** The https address of a picture. */
	image?: string | null;
}

const { title, text, image } = Astro.props;
---

<div class="border-border border-b">
	<div
		class:list={[
			"mx-auto grid max-w-page items-center gap-10 px-4 py-14 sm:px-6 sm:py-20",
			image && "lg:grid-cols-2",
		]}
	>
		<div>
			<h1 class="max-w-3xl sm:text-6xl">{title}</h1>
			{text && <p class="mt-4 max-w-xl text-muted-foreground text-xl">{text}</p>}
			{
				Astro.slots.has("default") && (
					<div class="mt-8 flex flex-wrap gap-3">
						<slot />
					</div>
				)
			}
		</div>
		{image && <img class="aspect-[4/3] w-full rounded-xl object-cover" src={image} alt="" />}
	</div>
</div>
