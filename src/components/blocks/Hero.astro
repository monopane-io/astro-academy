---
/**
 * The top of the home page: the academy's name, a line about it, and
 * optionally a picture beside them and buttons below (the default slot).
 */
interface Props {
	title: string;
	text?: string | null;
	/** The https address of a picture. */
	image?: string | null;
}

const { title, text, image } = Astro.props;
// A slot that was passed but came out empty (a condition that was false) takes no room.
const body = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";
---

<div class="border-border border-b">
	<div
		class:list={[
			"mx-auto grid max-w-page items-center gap-10 px-4 py-16 sm:px-6 sm:py-24",
			image && "lg:grid-cols-2",
		]}
	>
		<div>
			<h1 class="max-w-prose text-display">{title}</h1>
			{text && <p class="mt-4 max-w-prose text-pretty text-base text-muted-foreground sm:text-lg/relaxed">{text}</p>}
			{
				body && (
					<div class="mt-4 flex flex-wrap gap-4 sm:mt-6">
						<Fragment set:html={body} />
					</div>
				)
			}
		</div>
		{image && <img class="mx-auto hidden aspect-[4/3] w-full max-w-md rounded-xl object-cover lg:block" src={image} alt="" />}
	</div>
</div>
