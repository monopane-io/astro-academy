---
import Drawer from "../ui/Drawer.astro";
import AdminNavBody from "./AdminNavBody.astro";

/**
 * The admin area's navigation: a column down the side of a wide window; in a
 * narrow one, a bar across the top with one menu button that slides the same
 * column in as a drawer.
 */
interface Props {
	minutesLeft: number;
}

const { minutesLeft } = Astro.props;
const { config } = Astro.locals;
---

<div
	class="flex h-14 items-center justify-between border-border border-b bg-card p-3 pl-4 lg:hidden"
	data-admin-bar
>
	<p class="font-bold text-lg tracking-tight">
		{config.siteName}
		<span class="ml-1 font-medium text-muted-foreground text-sm">Admin</span>
	</p>
	<Drawer id="admin-menu" label="Menu">
		<AdminNavBody minutesLeft={minutesLeft} />
	</Drawer>
</div>

<aside
	class="hidden h-dvh w-full flex-col justify-between overflow-auto border-border border-r bg-card lg:sticky lg:top-0 lg:flex"
	data-admin-bar
>
	<AdminNavBody minutesLeft={minutesLeft} />
</aside>
