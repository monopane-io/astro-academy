---
import type { CourseCard } from "../../lib/pages";
import { surface } from "../../lib/ui";
import Badge from "../ui/Badge.astro";
import ProgressRing from "../ui/ProgressRing.astro";
import Tag from "../ui/Tag.astro";

/**
 * One course in the catalogue: its cover, name, a line about it, and where
 * the user stands: a ring and "3 of 8 done" while in progress, a badge once
 * completed.
 */
interface Props {
	course: CourseCard;
}

const { course } = Astro.props;
---

<li
	class:list={[surface, "group relative flex flex-col overflow-hidden transition focus-within:ring-[3px] focus-within:ring-ring/50 hover:shadow-lg"]}
	data-course-tile
>
	{
		course.imageUrl ? (
			<img
				class="aspect-[16/9] w-full object-cover"
				src={course.imageUrl}
				alt=""
				loading="lazy"
				decoding="async"
			/>
		) : (
			// No picture: the course's first letter, large, on the soft accent.
			<div
				class="flex aspect-[16/9] w-full items-end bg-primary-soft px-5 pb-2 font-bold text-7xl text-primary leading-none tracking-tighter"
				aria-hidden="true"
			>
				{course.title.trim().charAt(0)}
			</div>
		)
	}
	<div class="flex flex-1 flex-col p-4 sm:p-6">
		<h3 class="font-medium text-lg">
			{/* The whole tile is the link; tags sit above it so they stay clickable. */}
			<a class="outline-none after:absolute after:inset-0 focus-visible:ring-0 group-hover:text-primary" href={course.href}>
				{course.title}
			</a>
		</h3>
		{course.description && (
			<p class="mt-2 line-clamp-3 text-muted-foreground text-sm/relaxed">{course.description}</p>
		)}
		{
			course.tags.length > 0 && (
				<p class="relative z-10 mt-4 flex flex-wrap gap-1.5">
					{course.tags.map((tag) => (
						<Tag size="sm" href={tag.href}>
							{tag.name}
						</Tag>
					))}
				</p>
			)
		}
		{
			(course.duration || course.enrolled) && (
				<div class="mt-auto flex items-center justify-between gap-3 pt-4 text-sm">
					{course.duration && (
						<span class="text-muted-foreground" data-course-duration>
							{course.duration}
						</span>
					)}
					{course.enrolled === "completed" && <Badge variant="success" class="ml-auto">Completed</Badge>}
					{course.enrolled === "active" && course.progress && course.progress.total > 0 && (
						<span class="ml-auto flex items-center gap-2 text-muted-foreground tabular-nums" data-course-progress>
							<ProgressRing size="xs" value={course.progress.done} max={course.progress.total} />
							{course.progress.done} of {course.progress.total} done
						</span>
					)}
					{course.enrolled === "active" && !(course.progress && course.progress.total > 0) && (
						<Badge variant="neutral" class="ml-auto">In progress</Badge>
					)}
				</div>
			)
		}
	</div>
</li>
