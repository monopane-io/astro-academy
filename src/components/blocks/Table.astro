---
import { cx } from "../../lib/ui";
import Icon from "../ui/Icon.astro";

/**
 * Rows of the same kind of thing, in columns. Put one <tr> per row in the
 * slot, with a <td> for each column; `toolbar` sits above the table (a search
 * box, filters) and `footer` below it (a <Pager>).
 *
 * A column with `hide` is left out on a small screen, so keep what matters
 * most in the first column. A column with `sortHref` can be ordered by.
 */
interface Props {
	/** Read out as the table's name. */
	label: string;
	/** A heading above the rows, inside the card, with a line about them. */
	title?: string;
	description?: string;
	columns: {
		label: string;
		/** A heading above the rows, inside the card, with a line about them. */
		title?: string;
		description?: string;
		align?: "left" | "right";
		hide?: boolean;
		/** Makes the heading a link that orders the table by this column. */
		sortHref?: string;
		/** Set on the column the table is ordered by. */
		sorted?: "ascending" | "descending";
	}[];
	[attribute: string]: unknown;
}

const { label, title, description, columns, ...rest } = Astro.props;
---

<div class="overflow-hidden rounded-xl bg-card shadow-xs ring-1 ring-border" {...rest}>
	{
		(title || Astro.slots.has("toolbar")) && (
			<div class="flex flex-col items-start gap-4 border-border border-b px-4 py-4 md:flex-row md:items-center md:px-5">
				{title && (
					<div class="flex flex-1 flex-col gap-0.5">
						<h2 class="font-semibold">{title}</h2>
						{description && <p class="text-muted-foreground text-sm">{description}</p>}
					</div>
				)}
				<slot name="toolbar" />
			</div>
		)
	}
	<div class="overflow-x-auto">
		<table
			class="w-full text-left [&_tbody_tr:hover]:bg-muted/60 [&_tbody_tr]:border-border [&_tbody_tr]:border-t [&_tbody_tr]:transition-colors [&_td]:h-14 [&_td]:px-5 [&_td]:py-3 [&_td]:text-sm"
			aria-label={label}
		>
			<thead class="bg-muted">
				<tr>
					{
						columns.map((column) => (
							<th
								class={cx(
									"h-9 whitespace-nowrap px-5 py-2 font-semibold text-muted-foreground text-xs",
									column.align === "right" && "text-right",
									column.hide && "hidden md:table-cell",
								)}
								scope="col"
								aria-sort={column.sorted}
							>
								{column.sortHref ? (
									<a
										class={cx(
											"inline-flex items-center gap-1 hover:text-foreground",
											column.sorted && "text-foreground",
										)}
										href={column.sortHref}
									>
										{column.label}
										{column.sorted && (
											<Icon name={column.sorted === "ascending" ? "arrow-up" : "arrow-down"} size="sm" />
										)}
									</a>
								) : (
									column.label
								)}
							</th>
						))
					}
				</tr>
			</thead>
			<tbody>
				<slot />
			</tbody>
		</table>
	</div>
	{
		Astro.slots.has("footer") && (
			<div class="border-border border-t px-4 py-3 md:px-5">
				<slot name="footer" />
			</div>
		)
	}
</div>
