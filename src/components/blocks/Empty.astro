---
import Icon, { type IconName } from "../ui/Icon.astro";

/** What a list says when it has nothing in it yet, and what to do about it. */
interface Props {
	title: string;
	description?: string;
	icon?: IconName;
	/** Without its own border, inside something that has one. */
	bare?: boolean;
}

const { title, description, icon = "inbox", bare = false } = Astro.props;
---

<div
	class:list={[
		"flex min-w-0 flex-col items-center justify-center gap-6 text-balance p-6 text-center md:p-12",
		!bare && "rounded-lg border border-border border-dashed",
	]}
>
	<div class="flex max-w-sm flex-col items-center gap-2">
		<span class="mb-2 flex size-10 items-center justify-center rounded-lg bg-muted text-foreground">
			<Icon name={icon} size="lg" />
		</span>
		<p class="font-medium text-lg tracking-tight">{title}</p>
		{description && <p class="text-muted-foreground text-sm/relaxed">{description}</p>}
	</div>
	{
		Astro.slots.has("default") && (
			<div class="flex w-full max-w-sm flex-wrap items-center justify-center gap-2 text-sm">
				<slot />
			</div>
		)
	}
</div>
