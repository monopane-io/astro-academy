---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";

/** The bottom of a lesson: back to the one before, on to the next, or back to the course. */
interface Props {
	previous?: { href: string; title: string } | null;
	following?: { href: string; title: string } | null;
	courseHref: string;
}

const { previous, following, courseHref } = Astro.props;
---

<nav class="mt-12 flex h-16 flex-wrap items-center justify-between gap-2" aria-label="Lessons">
	{
		previous ? (
			<Button variant="secondary" size="sm" href={previous.href} class="max-w-full">
				<Icon name="arrow-left" />
				<span class="truncate">Previous: {previous.title}</span>
			</Button>
		) : (
			<span />
		)
	}
	{
		following ? (
			<Button variant="secondary" size="sm" href={following.href} class="max-w-full">
				<span class="truncate">Next: {following.title}</span>
				<Icon name="arrow-right" />
			</Button>
		) : (
			<Button variant="secondary" size="sm" href={courseHref}>
				Back to the course
			</Button>
		)
	}
</nav>
