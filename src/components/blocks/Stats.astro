---
import Icon, { type IconName } from "../ui/Icon.astro";

/** A row of numbers that sum up how things stand, each with its name. */
interface Props {
	items: { label: string; value: string | number; hint?: string; icon?: IconName }[];
	[attribute: string]: unknown;
}

const { items, ...rest } = Astro.props;
---

<dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4" {...rest}>
	{
		items.map((item) => (
			<div
				class="flex flex-col gap-6 rounded-xl border border-border bg-gradient-to-t from-primary/5 to-card py-6 shadow-sm dark:bg-card dark:bg-none"
				data-stat={item.label}
			>
				<div class="grid grid-cols-[1fr_auto] items-start gap-2 px-6">
					<dt class="text-muted-foreground text-sm">{item.label}</dt>
					{item.icon && <Icon name={item.icon} class="text-muted-foreground" />}
					<dd class="col-span-2 font-semibold text-2xl tabular-nums">{item.value}</dd>
				</div>
				{item.hint && <dd class="px-6 text-muted-foreground text-sm">{item.hint}</dd>}
			</div>
		))
	}
</dl>
