---
import type { CourseHead, LessonHead } from "../../lib/admin/content";
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";
import Menu from "../ui/Menu.astro";
import DeleteAction from "./DeleteAction.astro";
import PageHeader from "./PageHeader.astro";
import Tabs from "./Tabs.astro";

/** The top of the two pages about a lesson: its activities and its details. */
interface Props {
	course: CourseHead;
	lesson: LessonHead;
	tab: "activities" | "details";
}

const { course, lesson, tab } = Astro.props;
---

<PageHeader title={lesson.title} trail={[{ href: "/admin/courses", label: "Courses" }, { href: course.href, label: course.title }]}>
	<Fragment slot="status">
		<Badge variant={lesson.published ? "success" : "neutral"} data-lesson-published>
			{lesson.published ? "Published" : "Draft"}
		</Badge>
		{!course.published && <span>The course is a draft, so users do not see this yet.</span>}
	</Fragment>
	<Fragment slot="actions">
		{
			lesson.viewHref && (
				<Button href={lesson.viewHref} variant="ghost">
					View as a user
				</Button>
			)
		}
		<form method="post" action={lesson.href}>
			<input type="hidden" name="do" value="toggle-lesson" />
			<input type="hidden" name="status" value={lesson.published ? "published" : "draft"} />
			<Button type="submit" variant={lesson.published ? "secondary" : "primary"}>
				{lesson.published ? "Move back to draft" : "Publish lesson"}
			</Button>
		</form>
		<Menu label={`More actions for ${lesson.title}`}>
			<DeleteAction part="item"
				do="delete-lesson"
				action={lesson.detailsHref}
				label="Delete lesson"
				name={lesson.title}
				consequence="Its activities go with it."
			/>
		</Menu>
	</Fragment>
</PageHeader>
<DeleteAction part="dialog"
	do="delete-lesson"
	action={lesson.detailsHref}
	label="Delete lesson"
	name={lesson.title}
	consequence="Its activities go with it."
/>
<Tabs
	label="Parts of this lesson"
	items={[
		{ href: lesson.href, label: "Activities", current: tab === "activities" },
		{ href: lesson.detailsHref, label: "Details", current: tab === "details" },
	]}
/>
