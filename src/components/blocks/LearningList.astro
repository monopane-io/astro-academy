---
/** A named group of the user's courses on My learning. Put <LearningRow>s in it. */
interface Props {
	title: string;
	[attribute: string]: unknown;
}

const { title, ...rest } = Astro.props;
---

<section class="mt-10" {...rest}>
	<h2 class="font-semibold text-muted-foreground">{title}</h2>
	<ul class="mt-3 flex flex-col gap-3">
		<slot />
	</ul>
</section>
