---
import { surface } from "../../lib/ui";
/**
 * One of the user's courses: its name, a line about where they stand, and
 * what to do next (the `action` slot). `lead` holds a progress ring.
 */
interface Props {
	title: string;
	href: string;
	meta?: string | null;
}

const { title, href, meta } = Astro.props;
---

<li class={`flex flex-wrap items-center gap-4 p-4 sm:p-5 ${surface}`}>
	<slot name="lead" />
	<div class="min-w-48 flex-1">
		<h3 class="text-subheading">
			<a class="hover:text-primary" href={href}>{title}</a>
		</h3>
		{meta && <p class="mt-1 text-muted-foreground text-sm">{meta}</p>}
	</div>
	<slot name="action" />
</li>
