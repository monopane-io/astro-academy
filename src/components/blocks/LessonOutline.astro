---
import type { LessonPage } from "../../lib/pages";

/** A course's lessons as a track, with the one being read marked. Folds away on a small screen. */
interface Props {
	course: { title: string; href: string };
	outline: LessonPage["outline"];
}

const { course, outline } = Astro.props;
---

<p class="mb-4 text-sm">
	<a class="text-muted-foreground hover:text-primary" href={course.href}>{course.title}</a>
</p>
{/* Open on a wide screen; on a narrow one it folds away above the lesson. */}
<details class="group rounded-xl border border-border bg-card lg:border-0 lg:bg-transparent" open>
	<summary class="cursor-pointer px-4 py-3 font-semibold lg:hidden">Course contents</summary>
	<div class="px-4 pb-3 lg:p-0">
		{
			outline.map((section) => (
				<>
					{section.moduleTitle && (
						<h2 class="mt-5 mb-1 font-semibold text-muted-foreground text-sm first:mt-0">
							{section.moduleTitle}
						</h2>
					)}
					<ol class="track">
						{section.lessons.map((item) => (
							<li data-lesson-state={item.status}>
								<a
									class="text-muted-foreground hover:text-foreground aria-[current=page]:font-semibold aria-[current=page]:text-foreground"
									href={item.href}
									aria-current={item.current ? "page" : undefined}
								>
									{item.title}
								</a>
							</li>
						))}
					</ol>
				</>
			))
		}
	</div>
</details>
