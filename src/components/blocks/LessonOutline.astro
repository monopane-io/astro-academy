---
import type { LessonPage } from "../../lib/pages";
import LessonOutlineList from "./LessonOutlineList.astro";

/**
 * A course's lessons beside a lesson, with the one being read marked. A wide
 * screen shows them; a narrow one folds them away above the lesson, closed
 * until asked for.
 */
interface Props {
	course: { title: string; href: string };
	outline: LessonPage["outline"];
}

const { course, outline } = Astro.props;
---

<p class="mb-4 text-sm">
	<a class="text-muted-foreground hover:text-primary" href={course.href}>{course.title}</a>
</p>
<details class="rounded-xl border border-border bg-card shadow-sm lg:hidden" data-outline="folded">
	<summary class="cursor-pointer px-4 py-3 font-semibold text-sm">Course contents</summary>
	<div class="px-4 pb-3">
		<LessonOutlineList outline={outline} />
	</div>
</details>
<div class="hidden lg:block" data-outline="open">
	<LessonOutlineList outline={outline} />
</div>
