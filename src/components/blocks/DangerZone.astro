---
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import Dialog from "../ui/Dialog.astro";

/**
 * Deleting something for good. It is kept at the bottom of a details page,
 * apart from everything else, and asks once more before it is done.
 */
interface Props {
	do: string;
	/** What is being deleted: "this course". */
	what: string;
	/** Its name, for the question. */
	name: string;
	consequence: string;
}

const { do: action, what, name, consequence } = Astro.props;
const dialog = `confirm-${action}`;
---

<Card class="flex max-w-form flex-wrap items-center justify-between gap-4 border-destructive/30">
	<div>
		<h3 class="font-semibold">Delete {what}</h3>
		<p class="mt-1 text-muted-foreground text-sm">{consequence} This cannot be undone.</p>
	</div>
	<Button variant="destructive" data-dialog-open={dialog}>Delete {what}</Button>
</Card>

<Dialog id={dialog} title={`Delete ${name}?`}>
	{consequence} This cannot be undone.
	<Fragment slot="actions">
		<form method="dialog">
			<Button type="submit">Cancel</Button>
		</form>
		<form method="post">
			<input type="hidden" name="do" value={action} />
			<input type="hidden" name="confirm" value="yes" />
			<Button variant="destructive" type="submit">Yes, delete it</Button>
		</form>
	</Fragment>
</Dialog>
