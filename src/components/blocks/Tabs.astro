---
/** The parts of one thing, each on a page of its own: a course's lessons and its details. */
interface Props {
	label: string;
	items: { href: string; label: string; current: boolean }[];
}

const { label, items } = Astro.props;
---

<nav class="mb-8 flex gap-1 border-border border-b" aria-label={label}>
	{
		items.map((item) => (
			<a
				class="-mb-px inline-flex h-9 items-center justify-center border-transparent border-b-2 px-2 font-medium text-foreground/60 text-sm hover:text-foreground aria-[current=page]:border-foreground aria-[current=page]:text-foreground"
				href={item.href}
				aria-current={item.current ? "page" : undefined}
			>
				{item.label}
			</a>
		))
	}
</nav>
