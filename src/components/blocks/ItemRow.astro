---
/**
 * One thing in an <ItemList>: its name (a link to it), a line about it, where
 * it stands, and what can be done to it.
 *
 * Slots: `media` (an avatar or an icon), `lead` (a small label before the name: the kind of activity),
 * `status` (a badge) and `actions` (a button or a <Menu>).
 */
interface Props {
	title: string;
	href?: string;
	meta?: string | null;
	id?: string;
	[attribute: string]: unknown;
}

const { title, href, meta, id, ...rest } = Astro.props;
---

<li class:list={[
		"relative flex flex-wrap items-center gap-4 p-4 text-sm first:rounded-t-xl last:rounded-b-xl",
		href && "transition-colors hover:bg-muted/50",
	]} id={id} {...rest}>
	<slot name="media" />
	{
		Astro.slots.has("lead") && (
			<span class="hidden w-16 shrink-0 text-muted-foreground text-sm sm:block">
				<slot name="lead" />
			</span>
		)
	}
	<div class="flex min-w-0 flex-1 flex-col gap-1">
		<p class="truncate font-medium leading-snug">
			{href ? <a class="outline-none after:absolute after:inset-0 focus-visible:underline" href={href}>{title}</a> : title}
		</p>
		{meta && <p class="line-clamp-2 text-muted-foreground leading-normal">{meta}</p>}
	</div>
	<div class="relative z-10 flex shrink-0 items-center gap-2">
		<slot name="status" />
		<slot name="actions" />
	</div>
</li>
