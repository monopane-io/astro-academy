---
/**
 * One thing in an <ItemList>: its name (a link to it), a line about it, where
 * it stands, and what can be done to it.
 *
 * Slots: `media` (an avatar or an icon), `lead` (a small label before the name: the kind of activity),
 * `status` (a badge) and `actions` (a button or a <Menu>).
 */
interface Props {
	title: string;
	href?: string;
	meta?: string | null;
	id?: string;
	[attribute: string]: unknown;
}

const { title, href, meta, id, ...rest } = Astro.props;
---

<li class="flex items-center gap-x-4 gap-y-2 px-4 py-3 first:rounded-t-xl last:rounded-b-xl sm:px-5" id={id} {...rest}>
	<slot name="media" />
	{
		Astro.slots.has("lead") && (
			<span class="hidden w-20 shrink-0 text-muted-foreground text-sm sm:block">
				<slot name="lead" />
			</span>
		)
	}
	<div class="min-w-0 flex-1">
		<p class="truncate font-medium">
			{href ? <a class="hover:text-primary" href={href}>{title}</a> : title}
		</p>
		{meta && <p class="truncate text-muted-foreground text-sm">{meta}</p>}
	</div>
	<div class="flex shrink-0 items-center gap-2">
		<slot name="status" />
		<slot name="actions" />
	</div>
</li>
