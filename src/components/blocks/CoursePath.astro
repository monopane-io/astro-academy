---
/**
 * The academy as a path: one step for each course, joined by the track. A
 * signed-in user sees how far along it they are; each step goes to its course.
 */
interface Props {
	steps: { title: string; href: string; state: "todo" | "started" | "done" }[];
	/** A line under the path: "1 of 3 courses completed". */
	caption: string;
}

const { steps, caption } = Astro.props;
const shown = steps.slice(0, 12);
const said = { todo: "", started: " (in progress)", done: " (completed)" };
---

<div data-course-path>
	<ol class="flex flex-wrap items-center gap-y-3">
		{
			shown.map((step, index) => (
				<li class="flex items-center" data-path-state={step.state}>
					<a
						class:list={[
							"block size-4 rounded-full border-2 transition-transform hover:scale-125 focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2",
							step.state === "done" && "border-primary bg-primary",
							step.state === "started" && "border-primary bg-background",
							step.state === "todo" && "border-border bg-background",
						]}
						href={step.href}
						title={step.title}
						aria-label={`${step.title}${said[step.state]}`}
					/>
					{index < shown.length - 1 && (
						<span
							class:list={["h-0.5 w-8 sm:w-12", step.state === "done" ? "bg-primary" : "bg-border"]}
							aria-hidden="true"
						/>
					)}
				</li>
			))
		}
	</ol>
	<p class="mt-3 text-muted-foreground text-sm">{caption}</p>
</div>
