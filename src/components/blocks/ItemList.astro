---
import { surface } from "../../lib/ui";

/** A list of things of one kind, each an <ItemRow>, in one bordered surface. */
interface Props {
	/** `ol` when the order is the point: lessons, activities, questions. */
	ordered?: boolean;
	[attribute: string]: unknown;
}

const { ordered = false, ...rest } = Astro.props;
const List = ordered ? "ol" : "ul";
---

<List class={`flex flex-col divide-y divide-border ${surface}`} role="list" {...rest}>
	<slot />
</List>
