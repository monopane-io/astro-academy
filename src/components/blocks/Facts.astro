---
import Card from "../ui/Card.astro";

/** A few facts about one thing, each with its name. */
interface Props {
	items: { name: string; value: string; code?: boolean }[];
	title?: string;
	/** Name above value, for a narrow column. */
	stacked?: boolean;
	class?: string;
	[attribute: string]: unknown;
}

const { items, title, stacked = false, class: extra, ...rest } = Astro.props;
---

<Card flush title={title} class={extra} {...rest}>
	<dl class="divide-y divide-border text-sm">
		{
			items.map((item) => (
				<div class:list={["grid grid-cols-1 gap-1 px-6 py-3", !stacked && "sm:grid-cols-3 sm:gap-4"]}>
					<dt class="font-medium text-foreground">{item.name}</dt>
					<dd
						class:list={[
							"break-words text-muted-foreground",
							!stacked && "sm:col-span-2",
							item.code && "tabular-nums tracking-wider",
						]}
					>
						{item.value}
					</dd>
				</div>
			))
		}
	</dl>
</Card>
