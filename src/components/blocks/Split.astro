---
/**
 * A page about one thing, in two columns: what it holds on the left, and the
 * facts about it in the `aside` slot on the right. On a small screen the
 * aside comes first, above the rest.
 */
---

<div class="flex flex-col-reverse gap-8 lg:grid lg:grid-cols-[minmax(0,1fr)_17rem] lg:items-start">
	<div class="min-w-0">
		<slot />
	</div>
	<aside class="flex flex-col gap-4 lg:sticky lg:top-8">
		<slot name="aside" />
	</aside>
</div>
