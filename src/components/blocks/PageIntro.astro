---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";

/**
 * The top of a user page: the page above it, its title, a line about it,
 * and facts or topics underneath (the `meta` slot). An admin also gets a
 * button that opens the same thing in the admin area.
 */
interface Props {
	title: string;
	text?: string | null;
	back?: { href: string; label: string };
	/** Where an admin edits this; null for everyone else. */
	editHref?: string | null;
	editLabel?: string;
	/** A smaller title, for a page read in a narrow column: a lesson. */
	compact?: boolean;
	class?: string;
}

const {
	title,
	text,
	back,
	editHref,
	editLabel = "Edit",
	compact = false,
	class: extra,
} = Astro.props;
---

<header class={extra}>
	{
		back && (
			<p class="no-print mb-6 text-sm">
				<a class="inline-flex items-center gap-1 text-muted-foreground hover:text-primary" href={back.href}>
					<Icon name="chevron-left" size="sm" />
					{back.label}
				</a>
			</p>
		)
	}
	<h1 class:list={[compact && "font-semibold text-3xl tracking-tight sm:text-3xl"]}>{title}</h1>
	{
		editHref && (
			<p class="mt-3">
				<Button variant="secondary" size="sm" href={editHref} data-admin-edit>
					<Icon name="pencil" size="sm" />
					{editLabel}
				</Button>
			</p>
		)
	}
	{text && <p class:list={["text-muted-foreground", compact ? "mt-3 text-lg" : "mt-4 text-xl"]}>{text}</p>}
	{
		Astro.slots.has("meta") && (
			<div class="mt-5 flex flex-wrap items-center gap-2 text-sm">
				<slot name="meta" />
			</div>
		)
	}
</header>
