---
import Breadcrumbs from "./Breadcrumbs.astro";

/**
 * The top of an admin page: where you are, what this is, where it stands, and
 * what you can do with it. Every admin page starts with one, so the title is
 * always in the same place and the main action is always top right.
 *
 * Slots: `status` (a badge on the title's line, after it) and `actions`
 * (buttons and a menu, on the right).
 */
interface Props {
	title: string;
	/** The pages above this one, outermost first. */
	trail?: { href: string; label: string }[];
	/** One sentence under the title. */
	description?: string;
}

const { title, trail, description } = Astro.props;
---

<header class="mb-8">
	{trail && trail.length > 0 && <Breadcrumbs trail={trail} current={title} />}
	<div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
		<div class="min-w-0">
			<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
				<h1 class="text-title-sm">{title}</h1>
				{
					Astro.slots.has("status") && (
						<div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-muted-foreground text-sm">
							<slot name="status" />
						</div>
					)
				}
			</div>
			{description && <p class="mt-2 max-w-prose text-muted-foreground">{description}</p>}
		</div>
		{
			Astro.slots.has("actions") && (
				<div class="flex flex-wrap items-center gap-2">
					<slot name="actions" />
				</div>
			)
		}
	</div>
</header>
