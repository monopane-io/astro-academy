---
import Progress from "../ui/Progress.astro";

/**
 * Steps towards something, drawn on the track: each fills in as it is done,
 * and one still to do links to where it is done.
 */
interface Props {
	steps: { label: string; hint?: string; done: boolean; href?: string }[];
	[attribute: string]: unknown;
}

const { steps, ...rest } = Astro.props;
const done = steps.filter((step) => step.done).length;
---

<div {...rest}>
	<p class="mb-2 text-muted-foreground text-sm">{done} of {steps.length} done</p>
	<Progress value={done} max={steps.length} />
	<ol class="track mt-3">
		{
			steps.map((step) => (
				<li data-track={step.done ? "done" : "todo"} data-step={step.done ? "done" : "to-do"}>
					<span class:list={["font-medium", step.done && "text-muted-foreground"]}>
						{step.href && !step.done ? (
							<a class="hover:text-primary" href={step.href}>
								{step.label}
							</a>
						) : (
							step.label
						)}
					</span>
					<span class="text-muted-foreground text-sm">{step.done ? "Done" : "To do"}</span>
					{step.hint && !step.done && <span class="basis-full text-muted-foreground text-sm">{step.hint}</span>}
				</li>
			))
		}
	</ol>
</div>
