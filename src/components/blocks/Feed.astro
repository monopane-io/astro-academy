---
import Icon, { type IconName } from "../ui/Icon.astro";

/** What happened, newest first: one line each, with when. */
interface Props {
	/** `at` is the moment in ISO form, for the <time> element. */
	items: { text: string; when: string; at?: string; icon?: IconName }[];
	[attribute: string]: unknown;
}

const { items, ...rest } = Astro.props;
---

<ol class="relative ms-4 border-border border-s" {...rest}>
	{
		items.map((item) => (
			<li class="ms-7 mb-6 last:mb-0">
				<span class="-start-4 absolute flex size-8 items-center justify-center rounded-full bg-muted text-muted-foreground ring-4 ring-background">
					<Icon name={item.icon ?? "check"} />
				</span>
				<p class="pt-1 font-medium leading-tight">{item.text}</p>
				<p class="mt-1 text-muted-foreground text-sm">
					{item.at ? <time datetime={item.at}>{item.when}</time> : item.when}
				</p>
			</li>
		))
	}
</ol>
