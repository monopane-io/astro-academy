---
import type { CourseHead } from "../../lib/admin/content";
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";
import Menu from "../ui/Menu.astro";
import DeleteAction from "./DeleteAction.astro";
import PageHeader from "./PageHeader.astro";
import Tabs from "./Tabs.astro";

/** The top of the two pages about a course: its lessons and its details. */
interface Props {
	course: CourseHead;
	tab: "lessons" | "details";
	/** A line of facts after the badge: "3 enrolled, 1 completed". */
	facts?: string;
}

const { course, tab, facts } = Astro.props;
---

<PageHeader title={course.title} trail={[{ href: "/admin/courses", label: "Courses" }]}>
	<Fragment slot="status">
		<Badge variant={course.published ? "success" : "neutral"} data-course-state>
			{course.published ? "Published" : "Draft"}
		</Badge>
		{facts && <span data-course-numbers>{facts}</span>}
	</Fragment>
	<Fragment slot="actions">
		{
			course.viewHref && (
				<Button href={course.viewHref} variant="ghost">
					View as a user
				</Button>
			)
		}
		<slot name="actions" />
		<Menu label={`More actions for ${course.title}`}>
			<slot name="menu" />
			<DeleteAction part="item"
				do="delete-course"
				action={course.detailsHref}
				label="Delete course"
				name={course.title}
				consequence="Its lessons and activities go with it."
			/>
		</Menu>
	</Fragment>
</PageHeader>
<DeleteAction part="dialog"
	do="delete-course"
	action={course.detailsHref}
	label="Delete course"
	name={course.title}
	consequence="Its lessons and activities go with it."
/>
<Tabs
	label="Parts of this course"
	items={[
		{ href: course.href, label: "Lessons", current: tab === "lessons" },
		{ href: course.detailsHref, label: "Details", current: tab === "details" },
	]}
/>
