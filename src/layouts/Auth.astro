---
import DemoNotice from "../components/blocks/DemoNotice.astro";
import Card from "../components/ui/Card.astro";
import Icon from "../components/ui/Icon.astro";
import TextLink from "../components/ui/TextLink.astro";
import Document from "./Document.astro";

/**
 * The pages where someone signs in: nothing but the academy's name and one
 * card in the middle of the window.
 */
interface Props {
	title: string;
	/** The heading in the card; the page title when left out. */
	heading?: string;
}

const { title, heading = title } = Astro.props;
const { config } = Astro.locals;
---

<Document title={title} class="flex min-h-dvh flex-col bg-muted">
	<DemoNotice />
	<main id="main" class="flex flex-1 flex-col items-center justify-center gap-6 p-6 md:p-10">
		<a class="flex items-center gap-2 self-center font-medium" href="/">
			<span class="flex size-6 items-center justify-center rounded-md bg-brand text-brand-foreground">
				<Icon name="graduation" />
			</span>
			{config.siteName}
		</a>
		<div class="flex w-full max-w-sm flex-col gap-6">
			<Card>
				<h1 class="text-center font-semibold text-xl leading-none tracking-normal">{heading}</h1>
				<slot />
			</Card>
			<p class="px-6 text-center text-muted-foreground text-sm">
				<TextLink href="/">Back to the courses</TextLink>
			</p>
		</div>
	</main>
</Document>
