---
import DemoNotice from "../components/blocks/DemoNotice.astro";
import Card from "../components/ui/Card.astro";
import Document from "./Document.astro";

/**
 * The pages where someone signs in: nothing but the academy's name and one
 * card in the middle of the window.
 */
interface Props {
	title: string;
	/** The heading in the card; the page title when left out. */
	heading?: string;
}

const { title, heading = title } = Astro.props;
const { config } = Astro.locals;
---

<Document title={title}>
	<DemoNotice />
	<main class="flex flex-1 flex-col items-center justify-center px-4 py-12">
		<p class="mb-6">
			<a class="font-bold text-xl tracking-tight" href="/">{config.siteName}</a>
		</p>
		<Card class="w-full max-w-sm sm:p-8">
			<h1 class="text-heading">{heading}</h1>
			<slot />
		</Card>
		<p class="mt-6 text-sm">
			<a class="text-muted-foreground hover:text-foreground" href="/">Back to the courses</a>
		</p>
	</main>
</Document>
