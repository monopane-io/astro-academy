---
import DemoNotice from "../components/blocks/DemoNotice.astro";
import SiteFooter from "../components/blocks/SiteFooter.astro";
import SiteHeader from "../components/blocks/SiteHeader.astro";
import Document from "./Document.astro";

/**
 * A user page: the notice and the bar across the top, the page in a centred
 * column (a wide one with `wide`), and the foot. The `band` slot runs the full
 * width under the bar, for a hero.
 */
interface Props {
	title: string;
	description?: string | null;
	/** Use the full page width (catalogue, lesson player) instead of a text column. */
	wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
---

<Document title={title} description={description}>
		<DemoNotice />
		<SiteHeader />
		<slot name="band" />
		<main
			class:list={[
				"mx-auto w-full flex-1 px-4 py-10 sm:px-6 sm:py-14",
				wide ? "max-w-page" : "max-w-prose",
			]}
		>
			<slot />
		</main>
		<SiteFooter />
</Document>
