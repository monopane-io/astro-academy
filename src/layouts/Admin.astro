---
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import Document from "./Document.astro";

/**
 * The frame of the admin area: its own navigation down the side (across the
 * top on a narrow screen), a way back to the site, and how long the sign-in
 * has left. It does not carry the site's header: this is a different place,
 * for the people who run the academy.
 */
interface Props {
	title: string;
	/** How much longer the admin's sign-in lasts. */
	minutesLeft: number;
}

const { title, minutesLeft } = Astro.props;
const { config } = Astro.locals;
const path = Astro.url.pathname;
const sections = [
	{ href: "/admin", label: "Overview", icon: "dashboard" as const, current: path === "/admin" },
	{
		href: "/admin/courses",
		label: "Courses",
		icon: "book" as const,
		current: path.startsWith("/admin/courses"),
	},
	{
		href: "/admin/users",
		label: "Users",
		icon: "users" as const,
		current: path.startsWith("/admin/users"),
	},
];
const link =
	"flex items-center gap-2.5 rounded-md px-3 py-2 font-medium text-muted-foreground hover:bg-muted hover:text-foreground aria-[current=page]:bg-muted aria-[current=page]:text-foreground";
---

<Document title={`${title} (admin)`} class="min-h-dvh lg:grid lg:grid-cols-[15rem_minmax(0,1fr)]">
	<aside
		class="flex flex-wrap items-center gap-x-4 gap-y-2 border-border border-b bg-card px-4 py-3 lg:sticky lg:top-0 lg:h-dvh lg:flex-col lg:flex-nowrap lg:items-stretch lg:gap-6 lg:border-r lg:border-b-0 lg:px-4 lg:py-6"
		data-admin-bar
	>
		<p class="px-3 font-bold text-lg tracking-tight">
			{config.siteName}
			<span class="ml-1 font-medium text-muted-foreground text-sm">Admin</span>
		</p>
		<nav class="flex gap-1 lg:flex-col" aria-label="Admin">
			{
				sections.map((section) => (
					<a class={link} href={section.href} aria-current={section.current ? "page" : undefined}>
						<Icon name={section.icon} />
						{section.label}
					</a>
				))
			}
		</nav>
		<div class="ml-auto flex items-center gap-2 lg:mt-auto lg:ml-0 lg:flex-col lg:items-stretch lg:gap-3">
			<p class="hidden px-3 text-muted-foreground text-sm lg:block" data-admin-time-left>
				Signed in for {minutesLeft} more {minutesLeft === 1 ? "minute" : "minutes"}
			</p>
			<Button href="/" size="sm" variant="ghost" class="lg:justify-start">
				<Icon name="external" />
				View the site
			</Button>
			<form method="post" action="/admin/sign-out" class="lg:contents">
				<Button type="submit" size="sm" variant="ghost" class="lg:justify-start">
					<Icon name="log-out" />
					Leave admin
				</Button>
			</form>
		</div>
	</aside>
	<main class="w-full max-w-4xl px-4 py-8 sm:px-8 lg:px-10 lg:py-10">
		<slot />
	</main>
</Document>
